            function Library:PlacePopup(Popup, Anchor, MatchWidth)
                local Scale = self.MenuScale
                local Viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2New(1920, 1080)
                if not self.Holder.Instance.IgnoreGuiInset then
                    local Top, Bottom = game:GetService("GuiService"):GetGuiInset()
                    Viewport -= Top + Bottom
                end
                if MatchWidth then
                    local Layout = Popup:FindFirstChildOfClass("UIListLayout")
                    local ContentHeight = Layout and Layout.AbsoluteContentSize.Y / Scale + 10 or 25
                    Popup.Size = UDim2New(0, Anchor.AbsoluteSize.X / Scale, 0,
                        math.min(ContentHeight, 240, math.max(25, Viewport.Y / Scale - 16)))
                end
                local Size = Vector2New(Popup.Size.X.Offset, Popup.Size.Y.Offset) * Scale
                local Origin = Anchor.AbsolutePosition
                local Y = Origin.Y + Anchor.AbsoluteSize.Y + 6 * Scale
                if Y + Size.Y > Viewport.Y - 6 then Y = Origin.Y - Size.Y - 6 * Scale end
                Popup.Position = UDim2New(0, math.clamp(Origin.X, 6, math.max(6, Viewport.X - Size.X - 6)),
                    0, math.clamp(Y, 6, math.max(6, Viewport.Y - Size.Y - 6)))
            end

