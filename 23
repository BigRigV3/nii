                    return Name and AmmoTypes:FindFirstChild(tostring(Name))
                end
                                                                
                for Index = #(State.BulletsList or {}), 1, -1 do
                    local Round = State.BulletsList[Index]
                    if (tonumber(Round.Amount) or 0) > 0 then
                        local Ammo = Resolve(Round.AmmoType)
                        if Ammo then return Ammo end
                    end
                end
                local Weapon = State.weapon
                local function LoadedAmmo(Container)
                    local Loaded = Container and Container:FindFirstChild("LoadedAmmo")
                    local Ammo = Resolve(AmmoAttribute(Container, "AmmoType"))
                        or Resolve(AmmoAttribute(Loaded, "AmmoType"))
                        or (Loaded and Loaded:IsA("ValueBase") and Resolve(Loaded.Value))
                    if Ammo then return Ammo end
                    for _, Round in Loaded and Loaded:GetChildren() or {} do
                        Ammo = Resolve(AmmoAttribute(Round, "AmmoType")) or Resolve(Round.Name)
                        if Ammo then return Ammo end
                    end
                end
                local Ammo = LoadedAmmo(Weapon)
                if Ammo then return Ammo end
                local Attachments = Weapon and Weapon:FindFirstChild("Attachments")
                for _, Attachment in Attachments and Attachments:GetChildren() or {} do
                    Ammo = LoadedAmmo(Attachment)
                    if Ammo then return Ammo end
                end
                                                                                        
                                                                                        
                                                                                        
                local ItemProperties = Properties(Weapon)
                Ammo = Resolve(AmmoAttribute(ItemProperties, "AmmoType"))
                    or Resolve(AmmoAttribute(Weapon, "AmmoType"))
                if Ammo then return Ammo end
                local Gun = RangedWeapons and Weapon and RangedWeapons:FindFirstChild(Weapon.Name)
                Ammo = Resolve(AmmoAttribute(Gun, "DefaultAmmo"))
                if Ammo then return Ammo end
                for _, Attachment in Attachments and Attachments:GetChildren() or {} do
                    local MagazineProperties = Properties(Attachment)
                    Ammo = Resolve(AmmoAttribute(MagazineProperties, "AmmoType"))
                    if Ammo then return Ammo end
                end
            end
            function Controller:IsWallbangable(Origin, Part, State)
                if not Origin or not Part or not Part.Parent then return false end
                local Offset = Part.Position - Origin
                if Offset.Magnitude <= 0.001 then return false end
                local Direction, Position = Offset.Unit, Origin
                local Params = ManipulationParams()
                Params.IgnoreWater = true
                local ExitParams = RaycastParams.new()
                ExitParams.FilterType = Enum.RaycastFilterType.Include
                ExitParams.CollisionGroup = "WeaponRay"
                ExitParams.IgnoreWater = true
                local Ammo = ShotAmmo(State or LiveFPS)
                local Weapon = State and State.weapon or LiveFPS and LiveFPS.weapon
                local Gun = RangedWeapons and Weapon and RangedWeapons:FindFirstChild(Weapon.Name)
                local GunProperties = Properties(Weapon)
                local Power = tonumber(AmmoAttribute(Weapon, "ArmorPen"))
                    or tonumber(AmmoAttribute(GunProperties, "ArmorPen"))
                    or tonumber(AmmoAttribute(Gun, "ArmorPen"))
                    or tonumber(AmmoAttribute(Ammo, "ArmorPen")) or 0
                local Ignore = Params.FilterDescendantsInstances
                local Penetrated = false
                                                                                        
                for _ = 1, 16 do
                    local Remaining = (Part.Position - Position):Dot(Direction)
                    if Remaining <= 0 then return false end
                    local Hit = Cast(Position, Direction * Remaining, Params)
                    if not Hit or Hit.Instance:IsDescendantOf(Part.Parent) then return Penetrated end
                    local Wall = Hit.Instance
                    if Power <= 0 or ReadAttribute(Wall, "NoPen") then return false end
                    local Resistance = tonumber(ReadAttribute(Wall, "PenResistance"))
                        or MaterialResistance[Hit.Material.Name]
                    if not Resistance or Resistance < 0 then return false end
                    ExitParams.FilterDescendantsInstances = {Wall}
                    local Exit = Cast(Hit.Position + Direction * 5, -Direction * 5, ExitParams)
                    if not Exit then return false end
                    local Thickness = (Exit.Position - Hit.Position):Dot(Direction)
                    if Thickness <= 0.001 or Thickness >= 5 then return false end
                    local Cost = Resistance * Thickness
                    if Cost >= Power then return false end
                    Power = Power - Cost
                    Penetrated = true
                    table.insert(Ignore, Wall)
                                                                                    
                    Params.FilterDescendantsInstances = Ignore
                    Position = Hit.Position + Direction * 0.03
                end
                return false
            end
