        local NextGhostSnapshot, NextGhostPing, GhostPing = 0, 0, 0
        local function CaptureSnapshot()
            local Now = os.clock()
            if Now < NextGhostSnapshot then return end
            NextGhostSnapshot = Now + 1 / 30
            local Root = GhostCharacter and GhostCharacter:FindFirstChild("HumanoidRootPart")
            if not Root then return end
            LastSnapshotRoot = Root and Root.CFrame
            table.insert(SnapshotHistory, {Time = Now, Root = LastSnapshotRoot})
            while SnapshotHistory[1] and Now - SnapshotHistory[1].Time > 1.5 do table.remove(SnapshotHistory, 1) end
        end
        local function ServerSnapshotDelay()
            local Delay = 0
            local Now = os.clock()
            if Now >= NextGhostPing then
                NextGhostPing = Now + 1
                local Ok, Ping = pcall(Player.GetNetworkPing, Player)
                if Ok and type(Ping) == "number" and Ping == Ping then GhostPing = math.clamp(Ping * 0.5, 0, 1) end
            end
                                                                                                    
            Delay = GhostPing
            if E:IsAntiAimActive("FakeLag") then
                Delay += math.clamp((tonumber(E.AntiAim.Lag) or 0) / 1000, 0, 0.7)
            end
            return math.clamp(Delay, 0, 1.5)
        end
