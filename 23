                MenuAudioLastPlayed[Name] = Now
                local Requested = Settings.Asset
                task.spawn(function()
                    local Asset = self:LoadMenuSound(Name)
                    if not Asset or not self.Holder or not self.Holder.Instance.Parent or Settings.Asset ~= Requested then return end
                    if not Preview and not Settings.Enabled then return end
                    local Sound = Settings.Sound
                    if not Sound then
                        Sound = Instance.new("Sound")
                        Sound.Name = "Menu" .. Name
                        Sound.Parent = self.Holder.Instance
