                    local function FormatKeyTime(Info, Now)
                        if type(Info) ~= "table" or Info.Valid ~= true then return "Key: unavailable" end
                        local Expiry = tonumber(Info.ExpiresAt)
                        if not Expiry then return "Key: unavailable" end
                        if Expiry <= 0 then return "Key: Lifetime" end
                        local Left = math.max(0, math.floor(Expiry - Now))
                        if Left == 0 then return "Key: Expired" end
                        local Days = math.floor(Left / 86400)
                        local Hours = math.floor(Left % 86400 / 3600)
                        local Minutes = math.floor(Left % 3600 / 60)
                        if Days > 0 then return string.format("Key: %dd %dh left", Days, Hours) end
                        if Hours > 0 then return string.format("Key: %dh %dm left", Hours, Minutes) end
                        if Minutes > 0 then return string.format("Key: %dm left", Minutes) end
                        return string.format("Key: %ds left", Left)
