                WeaponSection:Slider({
                    Name = "Spread amount", Flag = "WeaponModSpreadAmount", Default = 0,
                    Min = 0, Max = 100, Decimals = 1, Suffix = "%",
                    Callback = function(Value) Mods.SpreadAmount = Value; CombatController:RefreshMods() end,
                })
                ModToggle(WeaponSection, "Recoil", "Recoil")
                WeaponSection:Slider({
                    Name = "Recoil amount", Flag = "WeaponModRecoilAmount", Default = 0,
                    Min = 0, Max = 100, Decimals = 1, Suffix = "%",
                    Callback = function(Value) Mods.RecoilAmount = Value; CombatController:RefreshMods() end,
                })
                ModToggle(WeaponSection, "No sway", "NoSway")
                ModToggle(WeaponSection, "No bobbing", "NoBobbing")
                ModToggle(WeaponSection, "No sprint animation", "NoSprintAnimation")
                ModToggle(WeaponSection, "Always sprint", "AlwaysSprint")
                ModToggle(WeaponSection, "Always full auto", "FullAuto")
                ModToggle(WeaponSection, "No obstruction", "NoObstruction")
                ModToggle(WeaponSection, "Instant aim", "InstantAim")
                ModToggle(WeaponSection, "Instant hit", "InstantHit")
                ModToggle(WeaponSection, "Instant equip", "InstantEquip")
                ModToggle(WeaponSection, "Keep equip animation", "KeepEquipAnimation")
                ModToggle(WeaponSection, "Sprint while shooting", "SprintShooting")
                ModToggle(AmmoSection, "Auto fill empty mags", "AutoFill")
                ModToggle(AmmoSection, "Packet reload", "PacketReload")
                ModToggle(AmmoSection, "Auto reload", "AutoReload")
                AmmoSection:Slider({Name = "Reload at", Flag = "WeaponModReloadThreshold", Default = Mods.ReloadThreshold,
                    Min = 0, Max = 100, Decimals = 1, Suffix = " rounds",
                    Callback = function(Value) Mods.ReloadThreshold = Value end})
            end
        end

        if Library.AutoloadConfig and not (LoaderTransition and LoaderTransition.SkipAutoload) then
            ReportLoadingProgress(0.95, "Loading saved config…")
            local Success, Error = pcall(function()
                local Loaded, Result = Library:LoadConfig(readfile(Library.Folders.Configs .. "/" .. Library.AutoloadConfig))
                assert(Loaded, tostring(Result or "Could not apply config"))
            end)
            if not Success then Library:Notification("Autoload error", tostring(Error), 5) end
        end
        Library:FinishBuilding()
        Library.LoadDuration = os.clock() - LoadTick
        if LoaderTransition and type(LoaderTransition.OnMenuReady) == "function" then
            local Success, Handled = pcall(LoaderTransition.OnMenuReady, LoaderTransition, Window, Library)
            if not Success or Handled ~= true then Window:SetOpen(true) end
            if getgenv().CinnamonLoaderTransition == LoaderTransition then
                getgenv().CinnamonLoaderTransition = nil
            end
        else
            Window:SetOpen(true)
        end
        Library:Notification("Loaded!", "Menu took "..string.format("%.4f", os.clock() - LoadTick).." seconds to load", 5)

        return Library
    end, function(Message)
        local Trace = debug and debug.traceback
        return type(Trace) == "function" and Trace(tostring(Message), 2) or tostring(Message)
    end)
    CinnamonEnvironment.__cinnamon_initializing = nil
    if not CinnamonSuccess then error(CinnamonResult, 0) end
    return CinnamonResult
