            local MenuAudioCache, MenuAudioLoading = {}, {}
            local MenuAudioTargets = setmetatable({}, {__mode = "k"})
            local MenuAudioLastPlayed = {}
            function Library:LoadMenuSound(Name)
                local Settings = self.MenuSounds[Name]
                local Source = Settings.Asset
                local NamedAsset = self.MenuSoundAssets[Source]
                if NamedAsset then
                    local Path = self.Folders.Assets .. "/" .. NamedAsset[1]
                    local Success = pcall(self.EnsureAsset, self, Path, NamedAsset[2], "mp3")
                    if not Success then return end
                    Source = Path
                end
                if Source == "" then Source = self.Folders.Assets .. "/" .. Settings.File end
                local Owner, Repo, Path = Source:match("^https://github%.com/([^/]+)/([^/]+)/blob/(.+)$")
                if Owner then Source = "https://raw.githubusercontent.com/" .. Owner .. "/" .. Repo .. "/" .. Path:gsub("%?.*$", "") end
                while MenuAudioLoading[Source] do task.wait() end
                if MenuAudioCache[Source] then return MenuAudioCache[Source] end
                if Settings.FailedSource == Source then return end
                local Remote = Source:match("^https://raw%.githubusercontent%.com/") ~= nil
                if not Remote and not isfile(Source) then return end
                MenuAudioLoading[Source] = true
                local Success, Asset = pcall(function()
                    local LocalPath = Source
                    if Remote then
                        local Hash = 0
                        for Index = 1, #Source do Hash = (Hash * 31 + Source:byte(Index)) % 4294967291 end
                        LocalPath = self.Folders.Assets .. "/MenuSound-" .. string.format("%08x", Hash) .. ".mp3"
                        if not isfile(LocalPath) then
                            local Bytes = game:HttpGet(Source)
                            local First, Second = Bytes:byte(1, 2)
                            assert(Bytes:sub(1, 3) == "ID3" or (First == 255 and Second and Second >= 224), "Menu sound URL must return an MP3 file")
                            writefile(LocalPath, Bytes)
                        end
                    end
                    return getcustomasset(LocalPath)
                end)
                MenuAudioLoading[Source] = nil
                if not Success then
                    Settings.FailedSource = Source
                    self:Notification("Menu sound error", tostring(Asset), 5)
                    return
                end
                MenuAudioCache[Source] = Asset
                return Asset
            end
