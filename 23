                    if not S.Enabled or Watched[Item] or not (Item:IsA("TextLabel") or Item:IsA("TextButton")) then return end
                    local Record = {Original = Item.Text}
                    Watched[Item] = Record
                    Record.Connection = Item:GetPropertyChangedSignal("Text"):Connect(function()
