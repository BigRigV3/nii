            local AutoSprintState
            local SprintAnimationWeights = setmetatable({}, {__mode = "k"})
            local SprintPoseStates = setmetatable({}, {__mode = "k"})
            local function UpdateSprintAnimation(State)
                if Controller.Active and Controller.Mods.NoSprintAnimation and State
                    and State.player == Player and State.character == Player.Character then
                    -- Weapon lowering is a separate pose blend, not the Sprint animation track.
                    SprintPoseStates[State] = true
                    local Tweens = State.tweens
                    if Tweens then
                        for _, Name in ipairs({"sprintTransitionIn", "sprintTransitionOut"}) do
                            local Transition = Tweens[Name]
                            if Transition then Transition:Cancel() end
                        end
                    end
                    local Blend = State.lerpValues and State.lerpValues.sprint
                    if Blend then Blend.Value = 0 end
                    local Track = State.clientAnimationTracks and State.clientAnimationTracks.Sprint
                    if Track and Track.IsPlaying then
                        if SprintAnimationWeights[Track] == nil then
                            SprintAnimationWeights[Track] = Track.WeightTarget
                        end
                        Track:AdjustWeight(0, 0)
                    end
                else
                    for SavedState in pairs(SprintPoseStates) do
                        local Tweens = SavedState.tweens
                        if Tweens then
                            for _, Name in ipairs({"sprintTransitionIn", "sprintTransitionOut"}) do
                                if Tweens[Name] then Tweens[Name]:Cancel(); Tweens[Name] = nil end
                            end
                        end
                        SprintPoseStates[SavedState] = nil
                    end
                    for Track, Weight in pairs(SprintAnimationWeights) do
                        pcall(function() Track:AdjustWeight(Weight, 0) end)
