                    or IsFog and NumberRange.new(0.5 * Speed, 1.5 * Speed)
                    or IsEmbers and NumberRange.new(2 * Speed, 6 * Speed)
                    or IsFireflies and NumberRange.new(0.5 * Speed, 2 * Speed) or NumberRange.new(0.5 * Speed, 2 * Speed)
