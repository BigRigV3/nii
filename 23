            function Controller:FillMagazine()
                if FillBusy or ReloadBusy or not self.Active or not self.Mods.AutoFill then return end
                local Ammo, Magazine = self:FindMagazineFill()
                if not Ammo then return end
                FillBusy = true
                task.spawn(function()
