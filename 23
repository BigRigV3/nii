                    or IsFireflies and NumberRange.new(5 / Speed, 9 / Speed) or NumberRange.new(4, 7)
                                                                                        
                WeatherEmitter.Rate = math.min(WeatherEmitter.Rate, 900 / WeatherEmitter.Lifetime.Max)
                local Size = math.clamp(tonumber(Settings.Size) or 1, 0.25, 3)
                WeatherEmitter.Size = NumberSequence.new((IsRain and 0.18 or IsSnow and 0.3
