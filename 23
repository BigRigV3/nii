                Icon.Name, Icon.BackgroundTransparency, Icon.BorderSizePixel = "Icon_" .. Name, 1, 0
                Icon.Image, Icon.ScaleType = self.Icons[Name] or "", Enum.ScaleType.Fit
                Icon.Position, Icon.Size = Position or UDim2New(), Size or UDim2New(0, 14, 0, 14)
