                local FontCache = {Monaco = Library.Font}
                local FontSources = {
                    ["Tahoma"] = {Name = "Tahoma", Url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/tahoma.ttf"},
                    ["Proggy Clean"] = {Name = "ProggyClean", Url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/ProggyClean.ttf"},
                }
                function Library:GetFontPreset(Name)
                    if FontCache[Name] then return FontCache[Name] end
                    local Face
                    if Name == "Fredoka One" then
                        Face = Font.fromEnum(Enum.Font.FredokaOne)
                    elseif Name == "Code" then
                        Face = Font.fromEnum(Enum.Font.Code)
                    else
                        local Source = FontSources[Name]
                        assert(Source, "Unknown font preset: " .. tostring(Name))
                        Face = CustomFont:New(Source.Name, 400, "Regular", {Url = Source.Url})
                    end
                    FontCache[Name] = Face
                    return Face
                end
                function Library:SetMenuFont(Name)
                    local Success, Face = pcall(self.GetFontPreset, self, Name)
                    if not Success then
                        self:Notification("Font error", tostring(Face), 5)
                        return false
                    end
                    local Changed = self.Font ~= Face
                    self.Font, self.MenuFontName = Face, Name
                    local function Apply(Item)
                        if Item:GetAttribute("CinnamonPreserveFont") then return end
                        if Item:IsA("TextLabel") or Item:IsA("TextButton") or Item:IsA("TextBox") then
                            Item.FontFace = self.Font
                        end
                    end
                    if Changed then
                        for _, Holder in ipairs({self.Holder.Instance, self.UnusedHolder.Instance}) do
                            for _, Item in ipairs(Holder:GetDescendants()) do
                                self:YieldLoadingWork()
                                Apply(Item)
                            end
                        end
                        for Viewer in pairs(self.MenuFontViewers or {}) do Viewer:Render() end
                    end
                    if not self.MenuFontConnection then
                        local function WatchFont(Item)
                            if not (Item:IsA("TextLabel") or Item:IsA("TextButton") or Item:IsA("TextBox")) then return end
                            task.defer(function()
                                if not self.Unloaded and (Item:IsDescendantOf(self.Holder.Instance)
                                    or Item:IsDescendantOf(self.UnusedHolder.Instance)) then Apply(Item) end
                            end)
                        end
                        self.MenuFontConnection = self:Connect(self.Holder.Instance.DescendantAdded, WatchFont, "MenuFont")
                        self:Connect(self.UnusedHolder.Instance.DescendantAdded, WatchFont, "InactiveMenuFont")
                    end
                    return true
                end
