                local Position = UAC and UAC:GetAttribute("LastVerifiedPos")
                if not ESP:ShouldStreamPlayer(Position) then continue end
                if Mode == "Render Priority" and (not Library.PlayerPriorities
                    or Library.PlayerPriorities[Target.Name] ~= "Priority") then continue end
                local Candidate = {Player = Target, Position = Position}
                if Mode == "Render Target" then
                    local Point, OnScreen = Camera:WorldToViewportPoint(Position)
                    if OnScreen and Point.Z > 0 then
                        local X, Y = Point.X - Camera.ViewportSize.X * 0.5, Point.Y - Camera.ViewportSize.Y * 0.5
                        local Score = X * X + Y * Y
                        if Score < BestScore then BestScore = Score; Candidates[1] = Candidate end
                    end
                else
                    Candidates[#Candidates + 1] = Candidate
                end
            end
            if #Candidates == 0 then return end
            ForceRenderWorker = task.defer(function()
                for _, Candidate in ipairs(Candidates) do
                    if Unloaded or not ESP.ForceRender
                        or ESP.ForceRenderMode ~= Mode then break end
                    if not ESP:ShouldStreamPlayer(Candidate.Position) then continue end
                    local Now = tick()
                    local Last = ForceRenderLast[Candidate.Player]
                    if not Last or Now - Last > 1.5 then
                        ForceRenderLast[Candidate.Player] = Now
                        -- Bound the request and space requests without blocking rendering.
                        local OK, Error = pcall(LocalPlayer.RequestStreamAroundAsync, LocalPlayer, Candidate.Position, 0.5)
                        if not OK then ESP.LastStreamError = tostring(Error) end
                        task.wait(0.2)
                    end
                end
                ForceRenderWorker = nil
            end)
        end)

