                local NoResults = Instances:Create("TextLabel", {
                    Parent = SearchResults.Instance, Size = UDim2New(1, -6, 0, 32),
                    Text = "No matching features", BackgroundTransparency = 1,
                    FontFace = Library.Font, TextSize = 10, TextColor3 = Library.Theme.Text,
                    ZIndex = 101, Visible = false,
                })
                NoResults:AddToTheme({TextColor3 = "Text"})
                local ResultButtons, SearchVersion = {}, 0
                local function PagePath(Page)
                    local Names = {}
                    while Page do
                        table.insert(Names, 1, Page.Name or "Page")
                        Page = Page.ParentPage
                    end
                    return table.concat(Names, " / ")
                end
                local function Navigate(Page, Element)
                    local Chain, Current = {}, Page
                    while Current do table.insert(Chain, 1, Current); Current = Current.ParentPage end
                    for _, Selected in ipairs(Chain) do
                        local Siblings = Selected.ParentPage and Selected.ParentPage.SubPages or Window.Pages
                        for _, Sibling in ipairs(Siblings) do Sibling:Turn(Sibling == Selected) end
                    end
                    if Page.SectionNavigation then Page.SectionNavigation:Reveal(Element) end
                    SearchVersion += 1
                    SearchResults.Instance.Visible = false
                    Items["Input"].Instance.Text = ""
                    Items["Input"].Instance:ReleaseFocus()
                    task.defer(function()
                        if Library.Unloaded or not Element.Parent then return end
                        local Column = Element:FindFirstAncestorWhichIsA("ScrollingFrame")
                        if Column then
                            local Offset = (Element.AbsolutePosition.Y - Column.AbsolutePosition.Y) / Library.MenuScale
                            local Maximum = math.max(0, (Column.AbsoluteCanvasSize.Y - Column.AbsoluteSize.Y) / Library.MenuScale)
                            Column.CanvasPosition = Vector2New(0, math.clamp(Column.CanvasPosition.Y + Offset - 8, 0, Maximum))
                        end
                    end)
                end
                local function RefreshSearch()
                    local Query = StringLower(Items["Input"].Instance.Text):match("^%s*(.-)%s*$")
                    local Results = {}
                    if Query ~= "" then
                        for Page, Entries in pairs(Library.SearchItems) do
                            if Page.Window == Window then
                                local Path = PagePath(Page)
                                for _, Entry in ipairs(Entries) do
                                    local Element = Entry.Element and Entry.Element.Instance
                                    local Section, Ancestor = "", Element
                                    while Ancestor do
                                        local Name = Ancestor:GetAttribute("CinnamonSearchSection")
                                        if Name then Section = " / " .. Name; break end
                                        Ancestor = Ancestor.Parent
                                    end
                                    local Text
                                    if Entry.Kind == "Tab" then
                                        Text = "TAB  ·  " .. Path
                                    elseif Entry.Kind == "Section" then
                                        Text = "SECTION  ·  " .. Path .. " / " .. tostring(Entry.Name)
                                    else
                                        Text = "FEATURE  ·  " .. tostring(Entry.Name) .. "  /  " .. Path .. Section
                                    end
                                    local Matches = true
                                    for Word in Query:gmatch("%S+") do
                                        if not StringFind(StringLower(Text), Word, 1, true) then Matches = false; break end
                                    end
                                    if Matches and Element and Element.Parent then
                                        local Rank = Entry.Kind == "Tab" and 1 or Entry.Kind == "Section" and 2 or 3
                                        Results[#Results + 1] = {Text = Text, Page = Page, Element = Element, Rank = Rank}
                                    end
                                end
                            end
                        end
                        table.sort(Results, function(A, B)
                            if A.Rank ~= B.Rank then return A.Rank < B.Rank end
                            return A.Text < B.Text
                        end)
                    end
                    for Index, Result in ipairs(Results) do
                        local Row = ResultButtons[Index]
                        if not Row then
                            Row = Instances:Create("TextButton", {
                                Parent = SearchResults.Instance, Size = UDim2New(1, -6, 0, 32),
                                BackgroundTransparency = 1, FontFace = Library.Font, TextSize = 10,
                                TextColor3 = Library.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
                                TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 101,
                            })
                            Row:AddToTheme({TextColor3 = "Text"})
                            Row:Connect("MouseButton1Click", function()
                                local Target = Row.Result
                                if Target then Navigate(Target.Page, Target.Element) end
                            end)
                            ResultButtons[Index] = Row
                        end
                        Row.Result = Result
                        Row.Instance.Text, Row.Instance.LayoutOrder, Row.Instance.Visible = Result.Text, Index, true
                    end
                    for Index = #Results + 1, #ResultButtons do
                        ResultButtons[Index].Result = nil
                        ResultButtons[Index].Instance.Visible = false
                    end
                    SearchResults.Instance.CanvasPosition = Vector2New()
                    NoResults.Instance.Visible = Query ~= "" and #Results == 0
                    SearchResults.Instance.Visible = Query ~= "" and Window.IsOpen
                end
                Library:Connect(Items["Input"].Instance:GetPropertyChangedSignal("Text"), function()
                    SearchVersion += 1
                    local Version = SearchVersion
                    task.delay(0.08, function()
                        if not Library.Unloaded and SearchVersion == Version then RefreshSearch() end
                    end)
                end)
                Items["Input"]:Connect("Focused", RefreshSearch)
                Items["Input"]:Connect("FocusLost", function(EnterPressed)
                    if EnterPressed and ResultButtons[1] and ResultButtons[1].Result then
                        local Target = ResultButtons[1].Result
                        Navigate(Target.Page, Target.Element)
                    end
                end)

                return setmetatable(Window, self)
            end

