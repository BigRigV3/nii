            Library.Unload = function(self)
                if self.Unloaded then return end
                self.Unloaded = true
                table.clear(self.PendingLayouts)
                if self.Streamproof then self.Streamproof:Destroy() end
                game:GetService("ContextActionService"):UnbindAction(self.MenuFireBinding or "CinnamonMenuBlockFire")
                self.MenuOpen = false
                if self.MenuBackgroundAnimation then self.MenuBackgroundAnimation:Disconnect() end
                if self.MenuBackgroundGui then self.MenuBackgroundGui:Destroy() end
                if self.FPSBoost then self.FPSBoost:Stop() end
                for Thread in pairs(self.NotificationTasks) do
                    if Thread ~= coroutine.running() then pcall(task.cancel, Thread) end
                end
                table.clear(self.NotificationTasks)
                if self.ActiveAnimations then table.clear(self.ActiveAnimations) end
                if self.ActivePointers then table.clear(self.ActivePointers) end
                self:CancelAssetLoading()
                if self.MouseUnlockBinding then
                    RunService:UnbindFromRenderStep(self.MouseUnlockBinding)
                end
                if self.RestoreMouse then
                    self.RestoreMouse()
                end

                for Index, Value in self.Connections do 
                    Value.Connection:Disconnect()
                end

                for Index, Value in self.Threads do 
                    if Value ~= coroutine.running() then pcall(coroutine.close, Value) end
                end

                table.clear(self.Connections)
                table.clear(self.Threads)
                if self.Holder then
                    self.Holder:Clean()
                end
                if self.UnusedHolder then
