            local NextStateSetup, SetupState, SetupSprings = 0, nil, nil
            local function Capture(State, Force)
                if State and State.player == Player then
                    LiveFPS = State
                    local Mods = Controller.Mods
                    local NeedsMods = Mods.NoObstruction or Mods.InstantAim or Mods.InstantEquip or Mods.FullAuto
                        or Mods.Recoil or Mods.NoSway or Mods.NoBobbing or Mods.NoSprintAnimation
                    if not Force and not NeedsMods and SetupState == State and State.weapon == PatchedWeapon
                        and SetupSprings == State.springs then return end
                    local Now = os.clock()
                    local Setup = Force or SetupState ~= State or State.weapon ~= PatchedWeapon
                        or SetupSprings ~= State.springs or Now >= NextStateSetup
                    if Setup then
                        SetupState, SetupSprings, NextStateSetup = State, State.springs, Now + 0.1
                        ApplyMods(State)
                        WatchAmmo(State)
                    end
                                                                                    
                                                                                        
                    if State.springs then
                        local Mods = Controller.Mods
                        if Mods.Recoil and Mods.RecoilAmount == 0 then
                            for _, Name in ipairs(RecoilSprings) do
                                local Spring = State.springs[Name]
                                if Spring then Spring.Position, Spring.Velocity, Spring.Target = Vector3.zero, Vector3.zero, Vector3.zero end
                            end
                        end
                        if Mods.NoSway then
                            for _, Name in ipairs(SwaySprings) do
                                local Spring = State.springs[Name]
                                if Spring then Spring.Position = Vector3.zero end
                            end
                        end
                        if Mods.NoBobbing then
                            for _, Name in ipairs(BobSprings) do
                                local Spring = State.springs[Name]
                                if Spring then
                                    Spring.Position, Spring.Velocity, Spring.Target = Vector3.zero, Vector3.zero, Vector3.zero
                                end
                            end
                        end
                        if not Setup then return end
                        for _, Name in ipairs(BobSprings) do
                            local Spring = State.springs[Name]
                            if Mods.NoBobbing
                                and Spring and type(Spring.shove) == "function" and not SpringWrappers[Spring] then
                                local Original = Spring.shove
                                local Wrapper = function(Self, Force, ...)
                                    if Controller.Active and Controller.Mods.NoBobbing then
                                        Self.Position, Self.Velocity, Self.Target = Vector3.zero, Vector3.zero, Vector3.zero
                                        return
                                    end
                                    return Original(Self, Force, ...)
                                end
                                Spring.shove = Wrapper
                                SpringWrappers[Spring] = true
                                table.insert(Wrappers, {Table = Spring, Key = "shove", Original = Original, Wrapper = Wrapper})
                            end
                        end
                        for _, Name in ipairs(RecoilSprings) do
                            local Spring = State.springs[Name]
                            if Mods.Recoil and Spring and type(Spring.shove) == "function" and not SpringWrappers[Spring] then
                                local Original = Spring.shove
                                local Wrapper = function(Self, Force, ...)
                                    if Controller.Active and Controller.Mods.Recoil then Force = Force * (Controller.Mods.RecoilAmount / 100) end
                                    return Original(Self, Force, ...)
                                end
                                Spring.shove = Wrapper
                                SpringWrappers[Spring] = true
                                table.insert(Wrappers, {Table = Spring, Key = "shove", Original = Original, Wrapper = Wrapper})
                            end
                        end
                    end
                end
            end
        
            local NextDiscovery = 0
            local function DiscoverFPS()
                if not Player.Character then return end
                local Loader = getgenv().CinnamonLoaderInstance
                if Loader and Loader.Alive and Loader.Busy then return end
                if os.clock() < NextDiscovery then return end
                NextDiscovery = os.clock() + 2
                if type(getgc) ~= "function" then return end
                local Success, Objects = pcall(getgc, true)
                if not Success or type(Objects) ~= "table" then return end
                for _, Object in ipairs(Objects) do
                    if type(Object) == "table" and rawget(Object, "player") == Player
                        and rawget(Object, "rs_Player") and rawget(Object, "springs")
                        and rawget(Object, "character") == Player.Character then Capture(Object); return end
                end
            end
        
