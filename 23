        local function BuildGhostPose(Motion, UndergroundPose)
            local Root = GhostCharacter and GhostCharacter:FindFirstChild("HumanoidRootPart")
            if not Root then return end
            table.clear(GhostOffsets)
            local Rest = {[Root] = CFrame.new()}
            local Joints = GhostJoints
            if GhostPoseDirty then
            table.clear(Joints)
            for _, Joint in ipairs(GhostCharacter:GetDescendants()) do
                if Joint:IsA("Motor6D") and Joint.Part0 and Joint.Part1
                    and (Joint.Part0 == Root or GhostParts[Joint.Part0])
                    and (Joint.Part1 == Root or GhostParts[Joint.Part1]) then
                    Joints[#Joints + 1] = Joint
                end
            end
            end
            local function Transform(Joint)
                if not Motion then return CFrame.identity end
                if Motion.PoseFrames[Joint] then return Motion.PoseFrames[Joint] end
                local Name = Joint.Name:lower()
                local Arm = Joint.Part1.Name:find("Arm", 1, true) or Joint.Part1.Name:find("Hand", 1, true)
                local Swing = math.sin(Motion.Phase) * Motion.Walk
                local Left = Joint.Part1.Name:find("Left", 1, true) ~= nil
                local Goal = CFrame.identity
                if UndergroundPose and not Arm then Goal = Joint.Transform
                elseif Name:find("shoulder", 1, true) then
                    Goal = CFrame.Angles((Left and Swing or -Swing) * 0.35 - Motion.Jump * 0.25, 0, 0)
                elseif Name:find("hip", 1, true) then
                    Goal = CFrame.Angles((Left and -Swing or Swing) * 0.55 - Motion.Jump * 0.2, 0, 0)
                elseif Name:find("knee", 1, true) then
                    Goal = CFrame.Angles(math.max(0, Left and Swing or -Swing) * 0.4 + Motion.Jump * 0.35, 0, 0)
                end
                local Pose = (Motion.JointFrames[Joint] or CFrame.identity):Lerp(Goal, Motion.Blend)
                Motion.JointFrames[Joint], Motion.PoseFrames[Joint] = Pose, Pose
                return Pose
            end
            for _ = 1, #Joints do
                local Changed = false
                for _, Joint in ipairs(Joints) do
                    if Rest[Joint.Part0] and not Rest[Joint.Part1] then
                        Rest[Joint.Part1] = Rest[Joint.Part0] * Joint.C0 * Transform(Joint) * Joint.C1:Inverse()
                        Changed = true
                    elseif Rest[Joint.Part1] and not Rest[Joint.Part0] then
                        Rest[Joint.Part0] = Rest[Joint.Part1] * Joint.C1 * Transform(Joint):Inverse() * Joint.C0:Inverse()
                        Changed = true
                    end
                end
                if not Changed then break end
            end
            local Complete = true
            for Part in pairs(GhostParts) do
                GhostOffsets[Part] = Rest[Part]
                if not Rest[Part] then Complete = false end
            end
            GhostPoseDirty = not Complete
        end
        local function AddGhostPart(Part)
