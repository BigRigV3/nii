            function Controller:TryAutoReload(State, RageOnly)
                local RageReload = self:IsRageActive() and self.Rage.AutoReload
                if not self.Active or not (RageOnly and RageReload or not RageOnly and (self.Mods.AutoReload or RageReload))
                    or not ReloadFocused or (Input.GetFocusedTextBox and Input:GetFocusedTextBox())
                    or ReloadBusy or FillBusy or not State or State.player ~= Player
                    or not State.isEquipped or not State.weapon or not State.weapon.Parent
                    or (State.character and State.character ~= Player.Character)
                    or State.useModuleName ~= "RangedWeaponDefault" or not State.Operational
                    or State.reloading or State.equipping or State.useDebounce then return false end
                for _, Window in State.CancelTables or {} do if Window.Visible then return false end end
                local Bullets = tonumber(State.Bullets)
                if not Bullets then return false end
                local Threshold = tonumber((RageOnly or not self.Mods.AutoReload)
                    and self.Rage.ReloadThreshold or self.Mods.ReloadThreshold) or 0
                local Capacity = tonumber(State.MaxAmmo)
                if Capacity and Capacity > 0 then Threshold = math.min(Threshold, Capacity - 1) end
                if Bullets > math.max(0, math.floor(Threshold)) then return false end
                if State.reloadType == "magazine" then
                    local Magazine = self:ChooseMagazine(State.weapon)
                    if not Magazine or (tonumber(Magazine:GetAttribute("LoadedAmmo")) or 0) <= Bullets then return false end
                end
                local Now = ManipulationClock()
                if self.AutoReloadAt and Now - self.AutoReloadAt < .5 then return false end
                self.AutoReloadAt = Now
                return self:TryPacketReload(State, true)
            end

            function Controller:ChooseMagazine(Weapon)
                local Props = Properties(Weapon)
                local Compatible = Props and Props:FindFirstChild("CompatibleMagazines")
                if not Compatible then return end
                local Best, Loaded = nil, 0
                for _, Item in ipairs(InventoryItems()) do
                    local Amount = tonumber(Item:GetAttribute("LoadedAmmo")) or 0
                    if Compatible:GetAttribute(Item.Name) and Amount > Loaded then Best, Loaded = Item, Amount end
                end
                return Best
            end
        
            function Controller:FindMagazineFill()
                local Items = InventoryItems()
                for _, Magazine in ipairs(Items) do
                    local Props = Properties(Magazine)
                    local AmmoType = Props and Props:GetAttribute("AmmoType")
                    local Capacity = Props and tonumber(Props:GetAttribute("MaxLoadedAmmo"))
                    local Loaded = tonumber(Magazine:GetAttribute("LoadedAmmo")) or 0
                    if AmmoType and Capacity and Loaded < Capacity then
                        for _, Ammo in ipairs(Items) do
                            local AmmoProperties = Properties(Ammo)
                            if AmmoProperties and AmmoProperties:GetAttribute("ItemType") == "Ammo"
                                and AmmoProperties:GetAttribute("SlotType") == AmmoType
                                and (tonumber(Ammo:GetAttribute("Amount")) or 0) > 0
                                and Ammo:GetAttribute("Slot") and Magazine:GetAttribute("Slot") then
                                return Ammo, Magazine
                            end
                        end
                    end
                end
            end
        
