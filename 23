                    local Fraction = Time - Count * Step
                    local Drop = 70 * (Step * Step * Count * (Count - 1) * 0.5 + Step * Count * Fraction)
                    return Offset + Velocity * Time + Vector3.new(0, Drop, 0)
                end
                local Maximum = 4000 / Speed
                local Low, High = 0, math.min(Offset.Magnitude / Speed, Maximum)
