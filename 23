        local function PlayerReportCount(Status)
            local UAC = Status and Status:FindFirstChild("UAC")
            local Reports = UAC and UAC:FindFirstChild("Reports")
            if not Reports then return nil end
            if Reports:IsA("ValueBase") then return tonumber(Reports.Value) end
            local Total, Found = 0, false
            for _, Value in pairs(Reports:GetAttributes()) do
                if type(Value) == "number" then Total, Found = Total + math.max(0, Value), true end
            end
            if not Found then
                for _, Value in ipairs(Reports:GetChildren()) do
                    if Value:IsA("ValueBase") and tonumber(Value.Value) then Total, Found = Total + math.max(0, tonumber(Value.Value)), true end
                end
            end
            return Found and Total or 0
        end
        local function PlayerSummary(Status)
            local Reports = PlayerReportCount(Status)
            local Journey = Status and Status:FindFirstChild("Journey")
            local Statistics = Journey and Journey:FindFirstChild("Statistics")
            local function Read(Name)
                if not Statistics then return nil end
                local Value = Statistics:GetAttribute(Name)
                local Child = Value == nil and Statistics:FindFirstChild(Name)
                if Child and Child:IsA("ValueBase") then Value = Child.Value end
                return tonumber(Value)
            end
            local Kills, Deaths, TimePlayed = Read("Kills"), Read("Deaths"), Read("TimePlayed")
            local KD = Kills and Deaths and string.format("%.2f", Kills / math.max(1, Deaths)) or "N/A"
            local Time = "N/A"
            if TimePlayed then
                local Minutes = math.floor(math.max(0, TimePlayed) / 60)
                Time = string.format("%dh %02dm", math.floor(Minutes / 60), Minutes % 60)
            end
            return string.format("Reports: %s  |  K/D: %s  |  Playtime: %s", Reports and tostring(Reports) or "N/A", KD, Time)
        end
