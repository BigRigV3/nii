                local Dock = Instance.new("TextButton")
                Dock.Name = "Dock"
                Dock.Text, Dock.FontFace, Dock.TextSize = "Dock", Library.Font, 11
                Dock.TextColor3, Dock.BackgroundColor3 = Library.Theme.Text, Library.Theme.Element
                Dock.BorderColor3 = Library.Theme.Outline
                Dock.Size, Dock.Position = UDim2.fromOffset(52, 20), UDim2.new(1, -60, 0, 4)
                Dock.Parent = Host
                Library:Connect(Dock.Activated, function() self:Dock(Record) end)
                local Area = Instance.new(Record.Kind == "Section" and "ScrollingFrame" or "Frame")
                Area.Name = "DetachedContent"
                Area.BackgroundTransparency, Area.BorderSizePixel = 1, 0
                Area.Position, Area.Size = UDim2.fromOffset(8, 32), UDim2.new(1, -16, 1, -40)
                if Area:IsA("ScrollingFrame") then
                    Area.CanvasSize = UDim2.new()
                    Area.AutomaticCanvasSize = Enum.AutomaticSize.Y
