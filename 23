                            local Capacity = math.max(0, math.floor(tonumber(State.MaxAmmo) or 0))
                            for _ = 1, Capacity do
                                if not self:IsPacketReloadEnabled(Automatic) or State.weapon ~= Weapon
                                    or EquippedWeapon() ~= Weapon or not Weapon.Parent then break end
                                local Before = tonumber(Weapon:GetAttribute("LoadedAmmo")) or tonumber(State.Bullets) or 0
