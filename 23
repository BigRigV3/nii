            local function Patch(Object, Key, Value, Enabled)
                if not Object then return end
                local Saved = Originals[Object]
                if Enabled then
                    if not Saved then Saved = {}; Originals[Object] = Saved end
                    local Applied = AppliedValues[Object]
                    if not Applied then Applied = {}; AppliedValues[Object] = Applied end
                    if Saved[Key] == nil or Object[Key] ~= Applied[Key] then
                        Saved[Key] = Object[Key] == nil and NIL or Object[Key]
                    end
                    if Object[Key] ~= Value then Object[Key] = Value end
                    Applied[Key] = Value
                elseif Saved and Saved[Key] ~= nil then
                    local Value = Saved[Key]
                    local Applied = AppliedValues[Object]
                    if Applied and Object[Key] == Applied[Key] then
                        if Value == NIL then Object[Key] = nil else Object[Key] = Value end
                    end
                    Saved[Key] = nil
                    if Applied then Applied[Key] = nil end
                end
            end
        
            local function PatchAttribute(Object, Key, Value, Enabled)
                if not Object then return end
                local Saved = AttributeOriginals[Object]
                if Enabled then
                    if not Saved then Saved = {}; AttributeOriginals[Object] = Saved end
                    if Saved[Key] == nil then
                        local Original = Object:GetAttribute(Key)
                        Saved[Key] = Original == nil and NIL or Original
                    end
                    if ReadAttribute(Object, Key) ~= Value then Object:SetAttribute(Key, Value) end
                elseif Saved and Saved[Key] ~= nil then
                    local Value = Saved[Key]
                    if Value == NIL then Object:SetAttribute(Key, nil) else Object:SetAttribute(Key, Value) end
                    Saved[Key] = nil
                end
            end
        
            local function RestorePatches()
                for Object, Saved in pairs(Originals) do
                    for Key, Value in pairs(Saved) do
                        local Applied = AppliedValues[Object]
                        if Applied and Object[Key] == Applied[Key] then
                            if Value == NIL then Object[Key] = nil else Object[Key] = Value end
                        end
                    end
                end
                for Object, Saved in pairs(AttributeOriginals) do
                    pcall(function()
                        for Key, Value in pairs(Saved) do
                            if Value == NIL then Object:SetAttribute(Key, nil) else Object:SetAttribute(Key, Value) end
                        end
                    end)
                end
                table.clear(Originals)
                table.clear(AppliedValues)
                table.clear(AttributeOriginals)
            end
        
            local PatchedWeapon
            local AutoFireModes = {"Auto"}
            local RecoilSprings = {"cameraRecoil", "recoilRot", "recoilPos"}
            local SwaySprings = {"sway", "gunSway"}
            local BobSprings = {"walkCycle", "sprintCycle", "strafeTilt", "jumpTilt", "jumpCameraTilt"}
            local GeometryKeys = {"ItemLength", "TouchWallPosY", "TouchWallPosZ", "TouchWallRotX", "TouchWallRotY"}
            local function ApplyMods(State)
                if not State or not Controller.Active then return end
                if State.weapon ~= PatchedWeapon then
                    RestorePatches()
                    PatchedWeapon = State.weapon
                end
                local Mods = Controller.Mods
                if State.weapon then
                                                                                                        
                    if State.settings then
                        for _, Key in ipairs(GeometryKeys) do
                            if State[Key] == nil and State.settings[Key] ~= nil then
                                local Scale = (Key == "TouchWallRotX" or Key == "TouchWallRotY") and 1.3 or 1
                                State[Key] = State.settings[Key] * Scale
                            end
                        end
                    end
                    Patch(State, "ItemLength", 0, Mods.NoObstruction)
                    Patch(State, "TouchWallPosY", 0, Mods.NoObstruction)
                    Patch(State, "TouchWallPosZ", 0, Mods.NoObstruction)
                    Patch(State, "TouchWallRotX", 0, Mods.NoObstruction)
                    Patch(State, "TouchWallRotY", 0, Mods.NoObstruction)
                    Patch(State, "AimInSpeed", 0.001, Mods.InstantAim)
                    Patch(State, "AimOutSpeed", 0.001, Mods.InstantAim)
                    Patch(State, "AimReadyTime", 0, Mods.InstantAim)
                    local Tool = State.itemProperties and State.itemProperties:FindFirstChild("Tool")
                    PatchAttribute(Tool, "ZoomSpeed", 0.001, Mods.InstantAim)
                    Patch(State, "EquipTValue", 0, Mods.InstantEquip)
                    Patch(State, "FireModes", AutoFireModes, Mods.FullAuto)
                    Patch(State, "FireModeIndex", 1, Mods.FullAuto)
                    PatchAttribute(State.weapon, "FireMode", "Auto", Mods.FullAuto)
                    PatchAttribute(State.weapon, "FireModeIndex", 1, Mods.FullAuto)
                    if State.settings then
                        Patch(State.settings, "EquipTValue", 0, Mods.InstantEquip)
                        Patch(State.settings, "UnequipTime", 0, Mods.InstantEquip)
                    end
                    if Mods.InstantEquip and not Mods.KeepEquipAnimation then
                        for _, Tracks in ipairs({State.clientAnimationTracks or {}, State.serverAnimationTracks or {}}) do
                            local Track = Tracks.Equip
                            if Track and Track.IsPlaying then Track:AdjustSpeed(1000) end
                        end
                    end
                end
                if State.springs then
                    for _, Name in ipairs(RecoilSprings) do
                        local Spring = State.springs[Name]
                        if Spring then
                            local Disabled = Mods.Recoil and Mods.RecoilAmount == 0
                                                                                                                
                            Patch(Spring, "Force", 0, Disabled)
                            Patch(Spring, "Speed", 0, Disabled)
                            if Disabled then
                                Spring.Position, Spring.Velocity, Spring.Target = Vector3.zero, Vector3.zero, Vector3.zero
                            end
                        end
                    end
                    for _, Name in ipairs(SwaySprings) do
                        local Spring = State.springs[Name]
                        if Spring then
                            local Disabled = Mods.NoSway
                            Patch(Spring, "Position", Vector3.zero, Disabled)
                            Patch(Spring, "Force", 0, Disabled)
                            Patch(Spring, "Speed", 0, Disabled)
                        end
                    end
                    for _, Name in ipairs(BobSprings) do
                        local Spring = State.springs[Name]
                        if Spring then
                            local Disabled = Mods.NoBobbing
                            Patch(Spring, "Position", Vector3.zero, Disabled)
                            Patch(Spring, "Force", 0, Disabled)
                            Patch(Spring, "Speed", 0, Disabled)
                            if Disabled then Spring.Position, Spring.Velocity, Spring.Target = Vector3.zero, Vector3.zero, Vector3.zero end
                        end
                    end
                end
            end
        
            local function WatchAmmo(State)
                if Testing and not Test.NativeAmmo then return end
                local Source = State.weapon
                local Attachments = Source and Source:FindFirstChild("Attachments")
                if Attachments and Attachments:GetAttribute("Magazine") then
                    Source = nil
                    for _, Item in ipairs(Attachments:GetChildren()) do
                        if Item:GetAttribute("Slot") == "Magazine" then Source = Item; break end
                    end
                end
                if Source == AmmoSource then return end
                if AmmoConnection then AmmoConnection:Disconnect(); AmmoConnection = nil end
                AmmoSource, LastServerAmmo = Source, Source and ReadAttribute(Source, "LoadedAmmo")
                if not Source then return end
                local Weapon = State.weapon
                AmmoConnection = Source:GetAttributeChangedSignal("LoadedAmmo"):Connect(function()
                    local Count = tonumber(ReadAttribute(Source, "LoadedAmmo"))
                    local Previous = tonumber(LastServerAmmo)
                    LastServerAmmo = Count
                    if not Controller.Active or State.character ~= Player.Character or State.weapon ~= Weapon or not Count then return end
                                                                                                        
                    if Count <= (tonumber(State.Bullets) or Count) or (Previous and Count > Previous) then
                        local Modules = ReplicatedStorage:FindFirstChild("Modules")
                        local Module = Modules and Modules:FindFirstChild("FPS")
                        local Binds = Module and Module:FindFirstChild("Binds")
                        local Adjust = Binds and Binds:FindFirstChild("AdjustBullets")
                        if Adjust and Adjust:IsA("BindableEvent") then
                            Adjust:Fire(State.rs_Player.Status.GameplayVariables:GetAttribute("EquipId"), 0)
                        end
                    end
                end)
