                        local Version = Revision
                        local Scale = Library.MenuScale or 1
                        local Reserved = Value and Value.Instance.AbsoluteSize.X / Scale + 8 or 0
                        local Width = math.max(24, math.floor(Row.AbsoluteSize.X / Scale - Reserved))
                        local Bounds = Label:MeasureLabel(Width)
                        if Library.Unloaded or Revision ~= Version then return end
                        local Size = UDim2New(0, Width, 0, math.max(15, math.ceil(Bounds.Y)))
                        if Text.Size ~= Size then Text.Size = Size end
                        local RowSize = UDim2.new(Row.Size.X, UDimNew(0,
                            math.max(MinimumHeight, math.ceil(Bounds.Y) + BottomHeight)))
                        if Row.Size ~= RowSize then Row.Size = RowSize end
                    end
                    local function QueueUpdate()
