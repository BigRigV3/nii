            local Id = Text:match("^(%d+)$") or Text:match("^rbxassetid://(%d+)$")
                or Text:match("^https?://www%.roblox%.com/asset/%?id=(%d+)$")
            if not Id or not tonumber(Id) or tonumber(Id) <= 0 then return nil end
            return Id
        end
        function E:UpdateUndergroundAnimation(Humanoid)
            local Settings = E.Underground
            local Id = NormalizeAnimationId(Settings.AnimationId)
            if not Settings.Enabled or not Settings.Pose or not E.Focused or not Humanoid or not Id then
                StopUndergroundAnimation()
                return
            end
            if UndergroundTrack and (UndergroundHumanoid ~= Humanoid or UndergroundAnimationId ~= Id or not UndergroundTrack.IsPlaying) then
                StopUndergroundAnimation()
            end
            if not UndergroundTrack then
                local Animator = Humanoid:FindFirstChildOfClass("Animator")
                if not Animator then
                    Animator = Instance.new("Animator")
                    Animator.Parent = Humanoid
                end
                local Animation = Instance.new("Animation")
                Animation.AnimationId = "rbxassetid://" .. Id
                local Ok, Track = pcall(function() return Animator:LoadAnimation(Animation) end)
                Animation:Destroy()
                if not Ok or not Track then
                    warn("[Cinnamon] Underground animation could not load: " .. tostring(Track))
                    return
                end
                UndergroundTrack, UndergroundAnimator = Track, Animator
                UndergroundHumanoid, UndergroundAnimationId = Humanoid, Id
                Track.Looped = true
                Track.Priority = Enum.AnimationPriority.Action4
                local Played, Error = pcall(function() Track:Play(0.1, 1, Settings.Freeze and 0 or 1) end)
                if not Played then
                    warn("[Cinnamon] Underground animation could not play: " .. tostring(Error))
                    StopUndergroundAnimation()
                    return
                end
            end
            pcall(function()
                local Time = math.max(0, tonumber(Settings.FreezeTime) or 0)
                if UndergroundTrack.Length > 0 then
                    Time = math.min(Time, math.max(0, UndergroundTrack.Length - 0.001))
                    if Settings.Freeze or UndergroundSeekTime ~= Time then
                        UndergroundTrack.TimePosition = Time
                        UndergroundSeekTime = Time
                    end
                end
                UndergroundTrack:AdjustSpeed(Settings.Freeze and 0 or 1)
            end)
        end
