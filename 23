        local function Refresh()
            local Entries, Names, Needed = Snapshot()
            if not table.find(Names, S.Selected) then S.Selected = "All active quests"; Entries, Names, Needed = Snapshot() end
            local Signature = table.concat(Names, "\0")
            if Signature ~= LastSignature then
                LastSignature = Signature
                Selector:Refresh(Names, true)
                Selector:Set(S.Selected)
            end
            local Old, New = {}, {}
            for Name in pairs(S.Needed) do Old[#Old + 1] = Name end
            for Name in pairs(Needed) do New[#New + 1] = Name end
            table.sort(Old); table.sort(New)
            if table.concat(Old, "\0") ~= table.concat(New, "\0") then
                S.Revision += 1
                if type(S.OnNeededChanged) == "function" then pcall(S.OnNeededChanged) end
            end
            S.Entries, S.Needed = Entries, Needed
            local Rows, CompleteCount, RequiredCount, QuestCounts, ReadyQuests = {}, 0, 0, {}, 0
            local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            local Targets = {}
            local Items = S.Enabled and (S.Line or S.TargetText) and ItemTargets(Entries) or {}
            Target = nil
            local function Consider(E, Part, Point, Kind, Item, ItemName, ObjectiveObject)
                if not S.Enabled or (not S.Line and not S.TargetText) or not Point or not Root or (E.Optional and not S.OptionalRoutes) then return end
                local Priority = (Kind == "Item" and 1 or Kind == "Location" and 2 or 3) + (E.Optional and 10 or 0)
                local D = (Point - Root.Position).Magnitude
                local Best = Targets[E.Id]
                if not Best or Priority < Best.Priority or (Priority == Best.Priority and D < Best.Distance) then
                    Targets[E.Id] = {Position = Point, Part = Part, Kind = Kind, Name = E.Objective,
                        QuestName = E.Name, Priority = Priority, Distance = D, Item = Item, ItemName = ItemName,
                        ObjectiveObject = ObjectiveObject}
                end
            end
            for _, E in ipairs(Entries) do
                local Q = QuestCounts[E.Id] or {Required = 0, Complete = 0}
                QuestCounts[E.Id] = Q
                if E.Carrying and E.Survive and not E.Finished and not E.Optional then Q.NeedsExtraction = true end
                if not E.Optional then
                    RequiredCount += 1; Q.Required += 1
                    if E.Complete or E.Progress >= E.Amount then CompleteCount += 1; Q.Complete += 1 end
                end
                E.Status = ObjectiveStatus(E)
                local ProgressText = string.format("%d/%d", math.min(E.Progress, E.Amount), E.Amount)
                if S.ShowComplete or not E.Finished then
                    local Text = E.Name .. " / " .. E.Objective .. " | " .. E.Status
                    if E.Optional then Text ..= " (optional)" end
                    Rows[#Rows + 1] = {Name = Text, Amount = 1, AmountLabel = ProgressText,
                        Caption = E.Name .. "\n" .. E.Objective .. "\n" .. E.Status .. " | " .. ProgressText,
                        Image = E.Image, NameColor = E.Finished and Color3.fromRGB(133, 200, 145) or Library.Theme.Accent}
                end
                if not E.Complete and E.Progress < E.Amount then
                    local Candidates = E.ItemName and Items[E.ItemName]
                    if Candidates then
                        for _, Candidate in ipairs(Candidates) do
                            Consider(E, Candidate.Part, Candidate.Part.Position, "Item", Candidate.Item, Candidate.ItemName)
                        end
                    end
                    Consider(E, E.TargetPart, E.Position, E.TargetKind, nil, nil, E.TargetObject)
                end
            end
            local Count = 0
            for Id, T in pairs(Targets) do
                GetRoute(Id).Target = T
                Count += 1
                if not Target or T.Priority < Target.Priority or (T.Priority == Target.Priority and T.Distance < Target.Distance) then Target = T end
            end
            for Id in pairs(Routes) do if not Targets[Id] then DestroyRoute(Id) end end
            S.Target, S.Targets = Target, Targets
            if Count > 1 then
                Route:SetText(string.format("Guiding %d active quests", Count))
            else
                Route:SetText(Target and ((Target.Kind == "Item" and "Collect: " or Target.Kind == "Hand in" and "Hand in: " or "Go to: ") .. Target.Name) or "No needed quest item loaded nearby")
            end
            if Count == 0 then HideGuide() end
            for _, Q in pairs(QuestCounts) do if Q.Required > 0 and Q.Complete == Q.Required and not Q.NeedsExtraction then ReadyQuests += 1 end end
            Summary:SetText(string.format("Objectives %d/%d | %d ready quests", CompleteCount, RequiredCount, ReadyQuests))
            RefreshAvailable()
            if S.Enabled and S.Window then Viewer:SetItems(Rows); Viewer:SetStats(S.Selected) end
            HighlightText()
            return Entries
        end
        S.Refresh = Refresh
        local function BindQuestChanges()
            local Root = QuestRoot()
            if Root == BoundQuestRoot then return end
            for _, Connection in ipairs(QuestStateConnections) do Connection:Disconnect() end
            for _, Connection in pairs(QuestObjectConnections) do Connection:Disconnect() end
            table.clear(QuestStateConnections)
            table.clear(QuestObjectConnections)
            BoundQuestRoot = Root
            if not Root then return end
            local function Changed()
                if not Alive or RefreshQueued then return end
                RefreshQueued = true
                task.defer(function()
                    RefreshQueued = false
                    if Alive then Elapsed = 0; Refresh() end
                end)
            end
            local function Watch(Object)
                if QuestObjectConnections[Object] then return end
                QuestObjectConnections[Object] = Object.AttributeChanged:Connect(Changed)
            end
            Watch(Root)
            for _, Object in ipairs(Root:GetDescendants()) do Watch(Object) end
            QuestStateConnections[#QuestStateConnections + 1] = Root.DescendantAdded:Connect(function(Object)
                Watch(Object)
                Changed()
            end)
            QuestStateConnections[#QuestStateConnections + 1] = Root.DescendantRemoving:Connect(function(Object)
                local Connection = QuestObjectConnections[Object]
                if Connection then Connection:Disconnect(); QuestObjectConnections[Object] = nil end
                Changed()
            end)
        end
        function S:IsNeeded(Name) return self.Enabled and self.HighlightItems and self.Needed[Name] == true end
        function S:GetLootNeeds()
            local Entries = Snapshot(true)
            local Needed, Counts = {}, InventoryCounts()
            for _, Entry in ipairs(Entries) do
                if Entry.Type == "HandOver" and not Entry.Complete and Entry.ItemName then
                    local Missing = math.max(0, Entry.Amount - Entry.Progress)
                    Needed[Entry.ItemName] = (Needed[Entry.ItemName] or 0) + Missing
                end
            end
            for Name, Amount in pairs(Needed) do Needed[Name] = math.max(0, Amount - (Counts[Name] or 0)) end
            return Needed
        end
