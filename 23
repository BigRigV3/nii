            function Library:YieldLoadingWork()
                if not BuildTransition or coroutine.running() ~= BuildThread then return end
                BuildChecks += 1
                if BuildChecks >= 128 then
                    BuildChecks = 0
                    if getgenv().CinnamonLoaderTransition ~= BuildTransition then
                        BuildTransition = nil
                        return
                    end
                end
                if type(BuildTransition.YieldWork) == "function" then BuildTransition:YieldWork() end
            end

            function Library:QueueLayout(Callback)
                if self.Unloaded or self.Unloading then return end
                if self.Building then
                    self.PendingLayouts[Callback] = true
                else
                    task.defer(Callback)
                end
            end

            function Library:FinishBuilding()
