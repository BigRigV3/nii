                    Params.FilterType = Enum.RaycastFilterType.Exclude
                    Params.CollisionGroup = "WeaponRay"
                    local Excluded = {workspace.CurrentCamera, Player.Character, workspace:FindFirstChild("NoCollision")}
                    Params.FilterDescendantsInstances = Excluded
                    local Hit = workspace:Raycast(Shot.Origin, Shot.Part.Position - Shot.Origin, Params)
