        function E:LogObservedDamage(Id, Humanoid, Damage, Killed)
            if not self.Active or not self.HitLogs.Enabled or type(Damage) ~= "number" or Damage <= 0 or Damage ~= Damage then return end
            local Now = os.clock()
            local function Eligible(Candidate)
                return Candidate and Candidate.Accepted and Candidate.Humanoid == Humanoid
                    and Candidate.ReportedAt and Now - Candidate.ReportedAt <= 1.5
            end
            local Entry = LogsById[Id]
            local Waiting
            for _, Candidate in ipairs(Logs) do
                if Eligible(Candidate) and Candidate.Damage == 0 then Waiting = Candidate; break end
            end
            if Waiting then Entry = Waiting
            elseif not Eligible(Entry) then return end
                                                                                    
                                                                                    
            Entry.Damage += Damage
            Entry.Hit = Killed and "death observed" or "damage observed"
            Entry.PulseAt = os.clock()
            Entry.Expires = os.clock() + self.HitLogs.Duration
            return true
        end
