                WeatherEmitter.Squash = NumberSequence.new(IsRain and 5 or 0)
                WeatherEmitter.SpreadAngle = IsRain and Vector2.new(4, 4) or Vector2.new(15, 15)
                WeatherEmitter.Rotation = IsRain and NumberRange.new(0) or NumberRange.new(0, 360)
                WeatherEmitter.RotSpeed = IsRain and NumberRange.new(0) or NumberRange.new(-35, 35)
