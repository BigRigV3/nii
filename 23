            do
                local ReadIdentity = getthreadidentity or getidentity
                local WriteIdentity = setthreadidentity or setidentity
                local CallbackIdentity
                if type(ReadIdentity) == "function" and type(WriteIdentity) == "function" then
                    local OK, Value = pcall(ReadIdentity)
                    if OK then CallbackIdentity = Value end
                end
                Library.SafeCall = function(self, Function, ...)
                    local Identity
                    if type(ReadIdentity) == "function" and type(WriteIdentity) == "function" then
                        local OK, Value = pcall(ReadIdentity)
                        if OK then Identity = Value end
                    end
                    if Identity ~= nil and CallbackIdentity ~= nil and Identity ~= CallbackIdentity then
                        local OK, Result = pcall(WriteIdentity, CallbackIdentity)
                        if not OK then
                            self.LastCallbackError = Result
                            return false, Result
                        end
                    end
                    local Success, Result = pcall(Function, ...)
                    -- Game callbacks can change the thread context used by subsequent UI updates.
                    if Identity ~= nil then
                        local Restored, RestoreError = pcall(WriteIdentity, Identity)
                        if not Restored then
                            self.LastCallbackError = RestoreError
                            return false, RestoreError
                        end
                    end

                    if not Success then
                        self.LastCallbackError = Result
                        return false, Result
                    end

                    return Success
                end
            end

            Library.Connect = function(self, Event, Callback, Name, Interval)
                if not Name then
                    self.UnnamedConnections += 1
                    Name = "Connection" .. tostring(self.UnnamedConnections)
                end

                local NewConnection = {
                    Event = Event,
                    Callback = Callback,
                    Name = Name,
                    Connection = nil
                }

                local LastWarning = -math.huge
                NewConnection.Connection = ConnectScheduled(Event, function(...)
                    if self.Unloaded or self.Unloading then return end
                    local OK, Result = self:SafeCall(Callback, ...)
                    if not OK and os.clock() - LastWarning >= 15 then
                        LastWarning = os.clock()
                        warn("[Cinnamon] " .. Name .. " callback failed: " .. tostring(Result))
                    end
                end, Interval)

                TableInsert(self.Connections, NewConnection)
                return NewConnection
            end

            
            function Library:Animate(Callback)
