                function Instances:MeasureLabel(Width)
                    local Text = self.Instance
                    local Cached = TextMeasurements[Text]
                    local Scale = Library.MenuScale or 1
                    if Cached and Cached.Text == Text.Text and Cached.Font == Text.FontFace
                        and Cached.Size == Text.TextSize and Cached.Width == Width and Cached.LineHeight == Text.LineHeight
                        and Cached.Scale == Scale then return Cached.Bounds end
                    local Measurement = {Text = Text.Text, Font = Text.FontFace, Size = Text.TextSize, Width = Width,
                        LineHeight = Text.LineHeight, Scale = Scale}
                    local Params = InstanceNew("GetTextBoundsParams")
                    Params.Text, Params.Font, Params.Size, Params.Width = Measurement.Text, Measurement.Font,
                        Measurement.Size * Scale, math.max(1, math.floor(Width * Scale))
                    local Success, Bounds = pcall(function() return game:GetService("TextService"):GetTextBoundsAsync(Params) end)
                    Params:Destroy()
                    Bounds = Success and Bounds or Text.TextBounds
                    Measurement.Bounds = Vector2New(Bounds.X / Scale, math.ceil(Bounds.Y * Measurement.LineHeight / Scale))
                    TextMeasurements[Text] = Measurement
                    return Measurement.Bounds
                end

