                end
                local function Unwatch(Item, Restore)
                    local Record = Watched[Item]
                    if not Record then return end
                    Record.Connection:Disconnect()
                    if Restore and Item.Parent and Item.Text == Record.Shown then Item.Text = Record.Original end
