                        Counts[Item.Name] = (Counts[Item.Name] or 0) + math.max(0, tonumber(Item:GetAttribute("Amount")) or 1)
                    end
                    local Nested = Item:FindFirstChild("Inventory")
                    if Nested then Visit(Nested) end
                end
            end
            if Inventory then Visit(Inventory) end
            return Counts
        end
        local function Position(Value)
            if typeof(Value) == "Vector3" then return Value end
            if type(Value) == "string" then
                local X, Y, Z = Value:match("^%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)")
                if X and tonumber(X) and tonumber(Y) and tonumber(Z) then return Vector3.new(tonumber(X), tonumber(Y), tonumber(Z)) end
            end
        end
        local function ObjectPart(Object)
            if not Object then return end
            if Object:IsA("BasePart") then return Object end
            if Object:IsA("Model") then return Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true) end
            local Model = Object:FindFirstAncestorOfClass("Model")
            return Model and (Model.PrimaryPart or Model:FindFirstChildWhichIsA("BasePart", true))
        end
        local function ObjectPosition(Object)
            local Part = ObjectPart(Object)
            return Part and Part.Position
        end
        local function AvailableQuestItem(Object, Name)
            if not Object or not Object:IsDescendantOf(workspace) or Object:GetAttribute("Hidden") == true then return false end
            if Object:IsA("ObjectValue") then
                local Template = Object.Value
                return Object.Parent.Name == "Inventory" and Template ~= nil and Template.Name == Name
                    and Object.Name == Name and (tonumber(Object:GetAttribute("Amount")) or 1) > 0
                    and Object.Parent.Parent ~= nil and Object.Parent.Parent:IsA("Model")
                    and tostring(Object:GetAttribute("Slot") or ""):match("^Container%d+$") ~= nil
            end
            return Object:IsA("Model") and Object.Name == Name and Object:GetAttribute("Collectable") == true
        end
        local function ItemTargets(Entries)
            local Wanted, Found = {}, {}
            for _, E in ipairs(Entries) do
                if E.Type == "HandOver" and not E.Complete and (E.Have or 0) < math.max(0, E.Amount - E.Progress) and E.ItemName then
                    Wanted[E.ItemName], Found[E.ItemName] = true, {}
                end
            end
            if next(Wanted) == nil then return Found end
            local function Add(Name, Object)
                if not Wanted[Name] or not AvailableQuestItem(Object, Name) then return end
                local Part = ObjectPart(Object)
                if Part and Part:IsDescendantOf(workspace) then
                    local List = Found[Name]
                    List[#List + 1] = {Part = Part, Item = Object, ItemName = Name}
                end
            end
            local Dropped = workspace:FindFirstChild("DroppedItems")
            if Dropped then
                for _, Object in ipairs(Dropped:QueryDescendants("Model")) do Add(Object.Name, Object) end
                for _, Item in ipairs(Dropped:QueryDescendants("ObjectValue")) do Add(Item.Name, Item) end
            end
            local Containers = workspace:FindFirstChild("Containers")
            if Containers then
                for _, Item in ipairs(Containers:QueryDescendants("ObjectValue")) do Add(Item.Name, Item) end
            end
            return Found
        end
        local KnownNames, WorldNames, WorldConnections = {}, {}, {}
        local WorldBound = false
        for _, Def in pairs(API and API.Quests or {}) do
            if type(Def.QuestGivenBy) == "string" then KnownNames[Def.QuestGivenBy] = true end
            for _, O in pairs(Def.Objectives or {}) do
                if type(O.ItemId) == "string" then KnownNames[O.ItemId] = true end
                if type(O.ContainerName) == "string" then KnownNames[O.ContainerName] = true end
            end
        end
        local function TrackWorld(Object)
            if KnownNames[Object.Name] and (Object:IsA("Model") or Object:IsA("BasePart")) then
                WorldNames[Object.Name] = WorldNames[Object.Name] or {}
                WorldNames[Object.Name][Object] = true
            end
        end
        local function FindWorld(Name)
            if not Name then return end
            Name = tostring(Name)
            if not WorldBound then
                WorldBound = true
                WorldConnections[#WorldConnections + 1] = workspace.DescendantAdded:Connect(TrackWorld)
                WorldConnections[#WorldConnections + 1] = workspace.DescendantRemoving:Connect(function(Object)
                    for _, List in pairs(WorldNames) do
                        for Tracked in pairs(List) do
                            if Tracked == Object or Tracked:IsDescendantOf(Object) then List[Tracked] = nil end
                        end
                    end
                end)
                local Selectors = {}
                for N in pairs(KnownNames) do Selectors[#Selectors + 1] = string.format("[Name = %q]", N) end
                if #Selectors > 0 then
                    for _, Object in ipairs(workspace:QueryDescendants(table.concat(Selectors, ", "))) do TrackWorld(Object) end
                end
            end
            if not KnownNames[Name] then
                KnownNames[Name] = true
                for _, Object in ipairs(workspace:QueryDescendants(string.format("[Name = %q]", Name))) do TrackWorld(Object) end
            end
            local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            local Best, BestObject, Distance = nil, nil, math.huge
            for Object in pairs(WorldNames[Name] or {}) do
                local Part = Object:IsDescendantOf(workspace) and Object:GetAttribute("Hidden") ~= true and ObjectPart(Object)
                if Part then
                    local D = Root and (Part.Position - Root.Position).Magnitude or 0
                    if D < Distance then Best, BestObject, Distance = Part, Object, D end
                end
            end
            return Best, BestObject
        end
        local function Destination(Objective, Def, Type)
            if Objective.MapName and Objective.MapName ~= workspace:GetAttribute("MapName") then return end
            local Items = workspace:FindFirstChild("QuestItems")
            local Object = Objective.ItemId and Items and Items:FindFirstChild(tostring(Objective.ItemId), true)
            local Part = Object and Object:GetAttribute("Hidden") ~= true and ObjectPart(Object)
            if not Part and Objective.ItemId then Part, Object = FindWorld(Objective.ItemId) end
            if Part then return Part.Position, Part, "Item", Object or Part end
            if Objective.ItemId and Type == "Fetch" then return end
            if Type == "HandOver" then return end
            local Point = Position(Objective.Position)
            if Point then return Point, nil, "Location" end
            local Name = Objective.ContainerName
            Part = FindWorld(Name)
            if Part then return Part.Position, Part, "Location" end
        end
        local function Snapshot(All)
            local Root, Counts = QuestRoot(), InventoryCounts()
            local Entries, Names, Needed = {}, {"All active quests"}, {}
            if Root then
                for _, Quest in ipairs(Root:GetChildren()) do
                    if Quest:GetAttribute("State") == "Active" then
                        Names[#Names + 1] = Quest.Name
                        local Def = API and API.Quests and API.Quests[Quest.Name] or {}
                        if All or S.Selected == "All active quests" or S.Selected == Quest.Name then
                            for _, Objective in ipairs(Quest:GetChildren()) do
                                local O = Def.Objectives and (Def.Objectives[Objective.Name] or Def.Objectives[tonumber(Objective.Name)]) or {}
                                local Type = Objective:GetAttribute("Type") or O.Type or "Objective"
                                local Amount = math.max(1, tonumber(Objective:GetAttribute("Amount") or O.Amount) or 1)
                                local Complete = Objective:GetAttribute("Complete") == true or Objective:GetAttribute("Carrying") == true or Objective:GetAttribute("Placed") == true
                                local Progress = Complete and Amount or tonumber(Objective:GetAttribute("Progress")) or 0
                                local ItemName = Objective:GetAttribute("ItemName") or O.ItemName
                                local Have = ItemName and (Counts[ItemName] or 0) or nil
                                if ItemName and not Complete and Progress < Amount then Needed[ItemName] = true end
                                local Description = O.Description or ItemName or Type
                                local ItemCatalog = RS:FindFirstChild("ItemsList")
                                local Item = ItemName and ItemCatalog and ItemCatalog:FindFirstChild(ItemName)
                                local Props = Item and Item:FindFirstChild("ItemProperties")
                                local Icon = Props and Props:FindFirstChild("ItemIcon")
                                local Entry = {Id = Quest.Name, Name = Def.Name or Quest.Name, Objective = Description,
                                    Type = Type, Progress = Progress, Amount = Amount, Have = Have, ItemName = ItemName,
                                    Complete = Complete, Finished = Objective:GetAttribute("Complete") == true or Objective:GetAttribute("Placed") == true or (Objective:GetAttribute("Carrying") ~= true and Progress >= Amount), Optional = Objective:GetAttribute("Optional") == true or O.Optional == true,
                                    Image = Icon and Icon.Image or Def.Image or "", ItemId = O.ItemId, MapName = O.MapName,
                                    Carrying = Objective:GetAttribute("Carrying") == true, Survive = Objective:GetAttribute("Survive") == true or O.Conditions and table.find(O.Conditions, "Survive") ~= nil, Definition = O}
                                if (S.Enabled or Page.Active) and not Complete and Progress < Amount then
                                    Entry.Position, Entry.TargetPart, Entry.TargetKind, Entry.TargetObject = Destination(O, Def, Type)
                                end
                                if Type == "HandOver" and not Complete and Have and Have + Progress >= Amount then
                                    local Part = (S.Enabled or Page.Active) and FindWorld(Def.QuestGivenBy)
                                    if Part then Entry.Position, Entry.TargetPart, Entry.TargetKind = Part.Position, Part, "Hand in" end
                                end
                                Entries[#Entries + 1] = Entry
                            end
                        end
                    end
                end
            end
            table.sort(Names, function(A, B) if A == "All active quests" then return true elseif B == "All active quests" then return false end return A < B end)
            table.sort(Entries, function(A, B) if A.Id ~= B.Id then return A.Id < B.Id end return A.Objective < B.Objective end)
            return Entries, Names, Needed
        end
        local function ObjectiveStatus(E)
            local Remaining = math.max(0, E.Amount - E.Progress)
            if E.Carrying then return "Carrying quest item - ready to submit" end
            if E.Complete or Remaining == 0 then return "Complete" end
            if E.MapName and E.MapName ~= workspace:GetAttribute("MapName") then return "Travel to " .. E.MapName end
            if E.Type == "HandOver" then
                local Missing = math.max(0, Remaining - (E.Have or 0))
                if Missing == 0 then return "Ready to hand in" end
                return string.format("Collect %d more | Inventory %d/%d", Missing, E.Have or 0, Remaining)
            end
            if E.Type == "Elimination" then return string.format("%d kills remaining", Remaining) end
            if E.Type == "Fetch" then return E.Position and "Collect quest item" or "Quest item not loaded on this map" end
            return E.Position and "Go to objective" or "Objective has no map destination"
        end
        local function RefreshAvailable(Force)
            if not AvailableSelector or not API or type(API.GetAvailableQuest) ~= "function" then return end
            local Now = os.clock()
            if not Force and Now - AvailableLastRefresh < 5 then return end
            AvailableLastRefresh = Now
            local Givers, Seen, IDs, Labels, Lookup = {}, {}, {}, {"Next available quest"}, {}
            for _, Def in pairs(API.Quests or {}) do if Def.QuestGivenBy then Givers[Def.QuestGivenBy] = true end end
            for Giver in pairs(Givers) do
                local OK, ID = CallQuestAPI(API.GetAvailableQuest, API, Player, Giver)
                if OK and type(ID) == "string" and not Seen[ID] then Seen[ID] = true; IDs[#IDs + 1] = ID end
            end
            table.sort(IDs)
            for _, ID in ipairs(IDs) do
                local Def = API.Quests[ID]
                local Label = Def and Def.Name and (Def.Name .. " (" .. ID .. ")") or ID
                Labels[#Labels + 1], Lookup[Label] = Label, ID
            end
            AvailableIDs, AvailableLabels = IDs, Lookup
            local Signature = table.concat(Labels, "\0")
            if Signature ~= AvailableSignature then
                AvailableSignature = Signature
                if not table.find(Labels, AvailableChoice) then AvailableChoice = "Next available quest" end
                AvailableSelector:Refresh(Labels, true); AvailableSelector:Set(AvailableChoice)
            end
        end
