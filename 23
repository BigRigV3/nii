                    local Compatible = Props:FindFirstChild("CompatibleAmmo")
                    local Preferred = Props:GetAttribute("PreferredAmmo")
                    local Best
                    for _, Candidate in ipairs(InventoryItems()) do
                        if Compatible and Compatible:GetAttribute(Candidate.Name)
                            and (tonumber(Candidate:GetAttribute("Amount")) or 0) > 0 then
                            if not Best or Candidate.Name == Preferred then Best = Candidate end
                            if Candidate.Name == Preferred then break end
                        end
                    end
                    return Best
                end
                if State.reloadType == "magazine" then
                    Item = self:ChooseMagazine(Weapon)
                    if not Item then return false end
                    Attachments = Weapon:FindFirstChild("Attachments")
                    local _, Variables = EquippedWeapon()
                    EquipId = Variables and Variables:GetAttribute("EquipId")
                    ItemSlot = Item:GetAttribute("Slot") or Item:GetAttribute("SlotType")
                    if not Attachments or not EquipId or not ItemSlot or not Remotes:FindFirstChild("Equip")
                        or not Remotes:FindFirstChild("InventoryMove") then return false end
                elseif State.reloadType == "loadByHand" then
                    if (tonumber(State.Bullets) or 0) >= (tonumber(State.MaxAmmo) or 0) then return true end
