                            assetId = getcustomasset(Library.Folders.Assets .. "/" .. Name .. ".ttf")
                        } }
                    }

                    local Definition = Library.Folders.Assets .. "/" .. Name .. ".current.json"
                    writefile(Definition, HttpService:JSONEncode(FontData))
                    return Font.new(getcustomasset(Definition))
                end

                function CustomFont:Get(Name)
                    if isfile(Library.Folders.Assets .. "/" .. Name .. ".current.json") then
