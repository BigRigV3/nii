                    Value = tostring(Value or "")
                    if Value ~= "" then Known[Value:lower()] = Kind end
                end
                local function Rebuild()
                    for _, Player in ipairs(Players:GetPlayers()) do
                        AddToken(Player.Name, "Player"); AddToken(Player.DisplayName, "Player")
                        AddToken(Player.UserId, "Player")
                    end
                    AddToken(game.JobId, "Server")
                    if #game.JobId >= 8 then AddToken(game.JobId:sub(1, 8), "Server") end
                    local Servers = game:GetService("ReplicatedStorage"):FindFirstChild("Servers")
                    if Servers then
                        for _, Record in ipairs(Servers:GetChildren()) do
                            local Id = tostring(Record:GetAttribute("JobId") or Record.Name)
                            AddToken(Id, "Server")
                            if #Id >= 8 then AddToken(Id:sub(1, 8), "Server") end
                            AddToken(Record:GetAttribute("ServerLocation"), "Server")
                        end
                    end
                    Tokens = {}
                    for Text, Kind in pairs(Known) do Tokens[#Tokens + 1] = {Text = Text, Kind = Kind} end
                    table.sort(Tokens, function(A, B)
                        if #A.Text ~= #B.Text then return #A.Text > #B.Text end
                        return A.Text < B.Text
                    end)
                    Buckets = {}
                    for _, Token in ipairs(Tokens) do
                        local First = Token.Text:sub(1, 1)
                        Buckets[First] = Buckets[First] or {}
                        table.insert(Buckets[First], Token)
                    end
                    local Parts = {}
                    for _, Token in ipairs(Tokens) do Parts[#Parts + 1] = Token.Text .. Token.Kind end
                    local NewSignature = table.concat(Parts, "\0")
                    local Changed = Signature ~= NewSignature
                    Signature = NewSignature
                    return Changed
                end
                local function Replacement(Kind, RichText)
                    local Text = S.Mode == "Blank" and "" or (Kind == "Server" and S.ServerText or S.PlayerText)
                    if RichText then Text = Text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;") end
                    return Text
                end
                function S:Sanitize(Text, Name, RichText)
                    if not self.Enabled then return Text end
                    local Key = tostring(Name or ""):lower():gsub("[^%a]", "")
                    if Key == "region" or Key:find("serverlocation", 1, true) or Key:find("serverid", 1, true)
                        or Key:find("jobid", 1, true) or Key:find("serverregion", 1, true)
                        or Key:find("servercountry", 1, true) or Key:find("serverip", 1, true) then
                        return Replacement("Server", RichText)
                    end
                    local Lower, Output, Index = Text:lower(), {}, 1
                    while Index <= #Text do
                        if RichText and Text:sub(Index, Index) == "<" then
                            local End = Text:find(">", Index, true)
                            if End then Output[#Output + 1] = Text:sub(Index, End); Index = End + 1; continue end
                        end
                        local Match
                        for _, Token in ipairs(Buckets[Lower:sub(Index, Index)] or {}) do
                            if Lower:sub(Index, Index + #Token.Text - 1) == Token.Text then
                                local Before, After = Lower:sub(Index - 1, Index - 1), Lower:sub(Index + #Token.Text, Index + #Token.Text)
                                if (Index == 1 or not Before:match("[%w_]")) and (After == "" or not After:match("[%w_]")) then
                                    Match = Token; break
                                end
                            end
                        end
                        if Match then Output[#Output + 1] = Replacement(Match.Kind, RichText); Index += #Match.Text
                        else Output[#Output + 1] = Text:sub(Index, Index); Index += 1 end
