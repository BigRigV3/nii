                    local Current = Item.Text
                    if Current ~= Record.Shown then Record.Original = Current end
                    Record.Shown = S:Sanitize(Record.Original, Item.Name, Item.RichText)
                    if Current ~= Record.Shown then Item.Text = Record.Shown end
