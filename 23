                            if Current and Current.Connected then
                                Current.Elapsed += Delta
                                if not Current.Busy and Current.Elapsed >= Current.Interval then
                                    local Elapsed = Current.Elapsed
                                    Current.Elapsed = 0
                                    coroutine.resume(Current.Worker, Elapsed)
                                end
                            end
                        end
                        if Group.Dirty then
                            Group.Dirty = false
                            local Write = 1
                            for Index = 1, #Entries do
                                local Current = Entries[Index]
                                if Current.Connected then
                                    Entries[Write] = Current
                                    Write += 1
                                end
                            end
                            for Index = #Entries, Write, -1 do Entries[Index] = nil end
                        end
                    end)
                end
