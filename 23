            Library.LayoutEditor = Editor

            local function MousePosition()
                local Position = Input:GetMouseLocation()
                if not Library.Holder.Instance.IgnoreGuiInset then
                    Position = Position - GuiService:GetGuiInset()
                end
                return Position
            end
            local function Contains(Gui, Position, HeaderOnly)
                if not Gui or not Gui.Parent or not Gui.Visible or not Gui:IsDescendantOf(Library.Holder.Instance) then return false end
                local Size, Origin = Gui.AbsoluteSize, Gui.AbsolutePosition
                if Position.X < Origin.X or Position.X > Origin.X + Size.X
                    or Position.Y < Origin.Y or Position.Y > Origin.Y + (HeaderOnly and math.min(24, Size.Y) or Size.Y) then return false end
                local Parent = Gui.Parent
                while Parent and Parent ~= Library.Holder.Instance do
                    if Parent:IsA("GuiObject") then
                        if not Parent.Visible then return false end
                        if Parent.ClipsDescendants then
                            local P, S = Parent.AbsolutePosition, Parent.AbsoluteSize
                            if Position.X < P.X or Position.Y < P.Y or Position.X > P.X + S.X or Position.Y > P.Y + S.Y then return false end
                        end
                    end
                    Parent = Parent.Parent
                end
                return true
            end
            local function ClampPosition(Position, Size)
                local Viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
                return Vector2.new(math.clamp(Position.X, 0, math.max(0, Viewport.X - Size.X)),
                    math.clamp(Position.Y, 0, math.max(0, Viewport.Y - Size.Y - 36)))
            end
            function Editor:HidePreview()
                if not self.PreviewTarget then return end
                self.PreviewTarget = nil
                if not self.Preview or not self.Preview.Visible then return end
                self.PreviewRevision = (self.PreviewRevision or 0) + 1
                local Revision = self.PreviewRevision
                if self.PreviewTween then self.PreviewTween:Cancel() end
                if self.StrokeTween then self.StrokeTween:Cancel() end
                local Info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                self.PreviewTween = TweenService:Create(self.Preview, Info, {BackgroundTransparency = 1})
                self.StrokeTween = TweenService:Create(self.PreviewStroke, Info, {Transparency = 1})
                self.PreviewTween:Play()
                self.StrokeTween:Play()
                task.delay(0.12, function()
                    if self.PreviewRevision == Revision and self.Preview.Parent then self.Preview.Visible = false end
                end)
            end
            function Editor:SetPreviewEnabled(Value)
                self.PreviewEnabled = Value == true
                if not self.PreviewEnabled then self:HidePreview() end
            end
            function Editor:ShowPreview(Position, Size)
                if not self.PreviewEnabled then return end
                Position = Vector2.new(math.floor(Position.X), math.floor(Position.Y))
                Size = Vector2.new(math.max(1, math.floor(Size.X)), math.max(1, math.floor(Size.Y)))
                if self.PreviewTarget and self.PreviewTarget.Position == Position and self.PreviewTarget.Size == Size then return end
                if not self.Preview then
                    local Preview = Instance.new("Frame")
                    Preview.Name, Preview.BorderSizePixel, Preview.ZIndex = "AeroSnapOutline", 0, 999
                    Preview.BackgroundTransparency, Preview.Visible = 1, false
                    Preview.Parent = Library.Holder.Instance
                    local Corner = Instance.new("UICorner")
                    Corner.CornerRadius, Corner.Parent = UDim.new(0, 5), Preview
                    local Stroke = Instance.new("UIStroke")
                    Stroke.Thickness, Stroke.Transparency, Stroke.Parent = 1.5, 1, Preview
                    self.Preview, self.PreviewStroke = Preview, Stroke
                end
                self.PreviewRevision = (self.PreviewRevision or 0) + 1
                self.PreviewTarget = {Position = Position, Size = Size}
                if self.PreviewTween then self.PreviewTween:Cancel() end
                if self.StrokeTween then self.StrokeTween:Cancel() end
                local Preview = self.Preview
                Preview.BackgroundColor3, self.PreviewStroke.Color = Library.Theme.Accent, Library.Theme.Accent
                if not Preview.Visible then
                    Preview.Position = UDim2.fromOffset(Position.X + Size.X * 0.02, Position.Y + Size.Y * 0.02)
                    Preview.Size = UDim2.fromOffset(Size.X * 0.96, Size.Y * 0.96)
                end
                Preview.Visible = true
                local Info = TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
                self.PreviewTween = TweenService:Create(Preview, Info, {
                    Position = UDim2.fromOffset(Position.X, Position.Y), Size = UDim2.fromOffset(Size.X, Size.Y),
                    BackgroundTransparency = 0.94,
                })
                self.StrokeTween = TweenService:Create(self.PreviewStroke, Info, {Transparency = 0.15})
                self.PreviewTween:Play()
                self.StrokeTween:Play()
            end
            function Editor:PreviewWindow(Gui, Position)
                if not self.PreviewEnabled or not Gui.Visible then return end
                Position = Position or MousePosition()
                local Viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
                if not Viewport then return end
                if not Library.Holder.Instance.IgnoreGuiInset then
                    local Top, Bottom = GuiService:GetGuiInset()
                    Viewport = Viewport - Top - Bottom
                end
                local Width, Height = Viewport.X, Viewport.Y
                local Left, Right, Top, Bottom = Position.X <= 24, Position.X >= Width - 24, Position.Y <= 24, Position.Y >= Height - 24
                local Origin, Size
                if (Left or Right) and (Top or Bottom) then
                    Origin = Vector2.new(Right and Width / 2 or 0, Bottom and Height / 2 or 0)
                    Size = Vector2.new(Width / 2, Height / 2)
                elseif Top then
                    Origin, Size = Vector2.zero, Viewport
                elseif Left or Right then
                    Origin, Size = Vector2.new(Right and Width / 2 or 0, 0), Vector2.new(Width / 2, Height)
                end
                if Origin then self:ShowPreview(Origin + Vector2.new(6, 6), Size - Vector2.new(12, 12)) else self:HidePreview() end
            end
            local function Label(Parent, Text, Size, Position)
                local Gui = Instance.new("TextLabel")
                Gui.BackgroundTransparency = 1
                Gui.Text = Text
                Gui.FontFace = Library.Font
