            function Library:DeferConfigWork(Key, Callback)
                if not self.ConfigLoading then return false end
                self.ConfigWork[Key] = Callback
                return true
            end
            local function ConfigValuesEqual(Current, Value)
                if type(Current) ~= type(Value) then return false end
                if type(Value) ~= "table" then return Current == Value end
                for Key, Expected in pairs(Value) do
                    local Actual = Current[Key]
                    if Key == "Color" then
                        if tostring(Actual):lower():gsub("^#", "") ~= tostring(Expected):lower():gsub("^#", "") then return false end
                    elseif Key == "Key" then
                        if tostring(Actual) ~= tostring(Expected) then return false end
                    elseif not ConfigValuesEqual(Actual, Expected) then return false end
                end
                for Key in pairs(Current) do if Value[Key] == nil then return false end end
                return true
            end
            Library.LoadConfig = function(self, Config)
                if self.ConfigLoading or CinnamonConfigLoading then return false, "A config is already loading" end
                local Parsed, Decoded = pcall(HttpService.JSONDecode, HttpService, Config)
                if not Parsed then return false, tostring(Decoded) end
                if type(Decoded) ~= "table" then return false, "Config must contain a JSON object" end
                for Key in pairs(Decoded) do
                    if type(Key) ~= "string" then return false, "Config must contain a JSON object" end
                end
                self.ConfigLoading, self.ConfigWork = true, {}
                CinnamonConfigLoading = true
                local SliceStart, SliceCount = os.clock(), 0
                local function YieldConfigWork()
                    SliceCount += 1
                    if SliceCount >= 16 or os.clock() - SliceStart >= 0.004 then
                        task.wait()
                        SliceStart, SliceCount = os.clock(), 0
                    end
                    if self.Unloaded then error("Menu was unloaded while loading config", 0) end
                end

                local Success, Result = Library:SafeCall(function()
                    if not ConfigValuesEqual(self.Flags.CustomHitsoundIds, Decoded.CustomHitsoundIds or {}) then
                        Library:SetCustomHitsoundIds(Decoded.CustomHitsoundIds or {})
                    end
                    for Index, Value in Decoded do 
                        YieldConfigWork()
                        if Index == "CustomHitsoundIds" then continue end
                        local SetFunction = Library.SetFlags[Index]

                        if not SetFunction then
                            continue
                        end
                        if ConfigValuesEqual(self.Flags[Index], Value) then continue end

                        if type(Value) == "table" and Value.Key then 
                            SetFunction(Value)
                        elseif type(Value) == "table" and Value.Color then
                            SetFunction(Value.Color, Value.Alpha)
                        else
                            SetFunction(Value)
                        end
                    end
                end)
                self.ConfigLoading = false
                local Work = self.ConfigWork
                self.ConfigWork = nil
                for _, Callback in pairs(Work) do
                    if self.Unloaded then break end
                    local OK, Error = self:SafeCall(Callback)
                    if not OK then Success, Result = false, Error end
                    task.wait()
                end
                CinnamonConfigLoading = false
                return Success, Result
            end

