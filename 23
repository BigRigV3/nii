                Instances.PlaceSubElements = function(self, Label, LeftOffset)
                    local Row, Text, Extras = self.Instance.Parent, Label.Instance, self.Instance
                    Text.AutomaticSize = Enum.AutomaticSize.None
                    Text.TextWrapped = true
                    Text.LineHeight = 1.25
                    Extras.AnchorPoint = Vector2New(0, 0.5)
                    Extras.Size = UDim2New(0, 0, 0, 18)
                    local MinimumHeight = math.max(18, Row.Size.Y.Offset)
                    local Pending, Revision = false, 0
                    local function UpdatePosition()
                        Pending = false
                        if not Library or Library.Unloaded or Library.Unloading or not Extras.Parent then return end
                        local Version = Revision
                        local Scale = Library.MenuScale or 1
                        local Width = Row.AbsoluteSize.X / Scale
                        local ExtraWidth = Extras.AbsoluteSize.X / Scale
                        local Gap = ExtraWidth > 0 and 14 or 0
                        local Available = math.max(24, Width - LeftOffset - ExtraWidth - Gap)
                        Available = math.floor(Available)
                        local Bounds = Label:MeasureLabel(Available)
                        if Library.Unloaded or Revision ~= Version then return end
                        local TextSize = UDim2New(0, Available, 0, math.max(15, math.ceil(Bounds.Y)))
                        if Text.Size ~= TextSize then Text.Size = TextSize end
                        local Height = math.max(MinimumHeight, math.ceil(Bounds.Y) + 4)
                        local RowSize = UDim2.new(Row.Size.X, UDimNew(0, Height))
                        if Row.Size ~= RowSize then Row.Size = RowSize end
                        local Position = UDim2New(0, LeftOffset + math.min(math.ceil(Bounds.X), Available) + Gap, 0.5, 0)
                        if Extras.Position ~= Position then Extras.Position = Position end
                    end
                    local function QueueUpdate()
                        Revision += 1
                        if Pending then return end
                        Pending = true
                        Library:QueueLayout(UpdatePosition)
                    end
                    Library:Connect(Text:GetPropertyChangedSignal("TextBounds"), QueueUpdate)
                    Library:Connect(Text:GetPropertyChangedSignal("Text"), QueueUpdate)
                    Library:Connect(Text:GetPropertyChangedSignal("FontFace"), QueueUpdate)
                    Library:Connect(Text:GetPropertyChangedSignal("TextSize"), QueueUpdate)
