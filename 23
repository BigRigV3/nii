        function E:LogShotResult(Shot, Reply, Reported)
            if not self.Active or not self.HitLogs.Enabled or Shot.Id == nil or type(Reply) ~= "boolean" then return end
            local EarlyReport = PendingLogReports[Shot.Id]
            if EarlyReport and os.clock() - EarlyReport.Created > 3 then
                PendingLogReports[Shot.Id], EarlyReport = nil, nil
            end
            local HitPart = EarlyReport and EarlyReport.Part or Shot.Part
            local Owner, Character = PlayerHit(HitPart)
            if EarlyReport then
                Owner, Character = EarlyReport.Owner, EarlyReport.Character
                Reported = true
            end
            if not Owner and not HitPart and Reply == false and Shot.Origin and Shot.Direction and Shot.Direction.Magnitude > 0 then
                local Params = RaycastParams.new()
                Params.FilterType, Params.CollisionGroup = Enum.RaycastFilterType.Exclude, "WeaponRay"
                local Ignore = {}
                for _, Object in {Player.Character, workspace.CurrentCamera, workspace:FindFirstChild("NoCollision")} do
                    if Object then Ignore[#Ignore + 1] = Object end
                end
                Params.FilterDescendantsInstances = Ignore
                local Hit = workspace:Raycast(Shot.Origin, Shot.Direction.Unit * 2000, Params)
                HitPart = Hit and Hit.Instance
                Owner, Character = PlayerHit(HitPart)
            end
            if Reply == true and not Reported and (Owner or not Shot.Part) then
                local Count = 0
                for Id, Pending in pairs(PendingLogShots) do
                    if os.clock() - Pending.Created > 3 then PendingLogShots[Id] = nil else Count += 1 end
                end
                if Count >= 128 then PendingLogShots[next(PendingLogShots)] = nil end
                PendingLogShots[Shot.Id] = {Created = os.clock()}
                return
            end
            if not Owner then return end
            PendingLogShots[Shot.Id], PendingLogReports[Shot.Id] = nil, nil
            local Entry = LogsById[Shot.Id]
            if not Entry then
                while #Logs >= 64 do RemoveLog(1) end
                LogNumber += 1
                Entry = {Id = Shot.Id, Number = LogNumber, Hit = "no report", Damage = 0, Created = os.clock()}
                LogsById[Shot.Id] = Entry
                table.insert(Logs, Entry)
            end
            Entry.Server = Reply == true and "accepted" or Reply == false and "rejected" or "unknown (no boolean reply)"
            Entry.Accepted = Reply == true
            Entry.Player, Entry.Humanoid = Owner, EarlyReport and EarlyReport.Humanoid or Character:FindFirstChildOfClass("Humanoid")
            Entry.Target, Entry.Bone = Character.Name, HitPart.Name
            if EarlyReport and Entry.Accepted then
                Entry.Target, Entry.Bone = Character.Name, HitPart.Name
                Entry.ReportedAt = os.clock()
                if Entry.Damage == 0 then Entry.Hit = "reported (unconfirmed)" end
            end
            Entry.Expires = os.clock() + self.HitLogs.Duration
            if EarlyReport and Entry.Accepted and self.ReplayHitLogDamage then
