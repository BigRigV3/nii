            function Library:AddSectionNavigation(Page, Section)
                Section.NavigationGroup = Library.SectionNavigationGroups[Section.Name] or Section.Name
                local Navigation = Page.SectionNavigation
                if not Navigation then
                    Navigation = {Sections = {}, Buttons = {}, Groups = {}, GroupCount = 0, Selected = nil}
                    Page.SectionNavigation = Navigation
                    function Navigation:Select(Selected)
                        self.Selected = Selected
                        Library:CloseOpenFrames()
                        for _, Entry in ipairs(self.Sections) do
                            Entry.Items.Section.Instance.Visible = Selected == nil or Entry.NavigationGroup == Selected
                        end
                        for _, Entry in ipairs(self.Buttons) do
                            local Active = Entry.Section == Selected
                            Entry.Button:Tween(nil, {BackgroundTransparency = Active and 0 or 1})
                            Entry.Stroke:Tween(nil, {Transparency = Active and 0 or 1})
                            Entry.Liner:Tween(nil, {BackgroundTransparency = Active and 0 or 1})
                            Entry.Glow:Tween(nil, {BackgroundTransparency = Active and 0 or 1})
                        end
                        for _, Column in ipairs(Page.ColumnsData) do Column.Instance.CanvasPosition = Vector2New() end
                    end
                    function Navigation:Reveal(Element)
                        for _, Entry in ipairs(self.Sections) do
                            local Frame = Entry.Items.Section.Instance
                            if Element == Frame or Element:IsDescendantOf(Frame) then
                                self:Select(Entry.NavigationGroup)
                                return
                            end
                        end
                    end
                end
                TableInsert(Navigation.Sections, Section)
                if not Navigation.Groups[Section.NavigationGroup] then
                    Navigation.Groups[Section.NavigationGroup] = true
                    Navigation.GroupCount += 1
                end
                if Navigation.GroupCount < 2 then return end
                if not Navigation.Bar then
                    local Root = Page.Items.Page.Instance
                    local Layout = Root:FindFirstChildOfClass("UIListLayout")
                    local Content = Instances:Create("Frame", {Parent = Root, Name = "SectionContent",
                        BackgroundTransparency = 1, BorderSizePixel = 0,
                        Position = UDim2New(0, 0, 0, 40), Size = UDim2New(1, 0, 1, -40)})
                    if Layout then Layout.Parent = Content.Instance end
                    for _, Column in ipairs(Page.ColumnsData) do Column.Instance.Parent = Content.Instance end
                    Navigation.Bar = Instances:Create("ScrollingFrame", {Parent = Root, Name = "SectionTabs",
                        Size = UDim2New(1, 0, 0, 28), BackgroundColor3 = Library.Theme.Background,
                        BorderSizePixel = 0, AutomaticCanvasSize = Enum.AutomaticSize.X,
                        CanvasSize = UDim2New(), ScrollingDirection = Enum.ScrollingDirection.X,
                        ScrollBarThickness = 2, ScrollBarImageColor3 = Library.Theme.Accent})
                    Navigation.Bar:AddToTheme({BackgroundColor3 = "Background", ScrollBarImageColor3 = "Accent"})
                    Navigation.Bar:Border("Outline")
                    Instances:Create("UIPadding", {Parent = Navigation.Bar.Instance,
                        PaddingLeft = UDimNew(0, 7), PaddingRight = UDimNew(0, 7)})
                    Instances:Create("UIListLayout", {Parent = Navigation.Bar.Instance,
                        FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
                        Padding = UDimNew(0, 8), SortOrder = Enum.SortOrder.LayoutOrder})
                    function Navigation:AddButton(Name, Target)
