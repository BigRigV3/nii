            Library.MenuBackgroundEnabled = false
            function Library:RefreshMenuBackground()
                local Show = self.MenuBackgroundEnabled and self.MenuBackgroundWindow and self.MenuBackgroundWindow.IsOpen
                if self.MenuBackgroundGui then self.MenuBackgroundGui.Enabled = Show == true end
                if self.MenuBackgroundAnimation then
                    self.MenuBackgroundAnimation:Disconnect()
                    self.MenuBackgroundAnimation = nil
                end
                if not Show then return end
                self.MenuBackgroundAnimation = self:Animate(function(Now)
                    for Index, Band in ipairs(self.MenuBackgroundBands) do
                        local Phase = Now * 0.045 + Index * 1.7
                        Band.Frame.Position = UDim2New(0.5 + 0.12 * MathSin(Phase), 0,
                            Band.Y + 0.06 * MathSin(Phase * 0.7), 0)
                        Band.Frame.Rotation = Band.Angle + 4 * MathSin(Phase * 0.6)
                        Band.Frame.BackgroundTransparency = 0.9 + 0.025 * MathSin(Phase)
                    end
                    for _, Star in ipairs(self.MenuBackgroundStars) do
                        local Y = (Star.Y - Now * Star.Speed) % 1
                        local Fade = math.min(1, Y * 8, (1 - Y) * 8)
                        Star.Frame.Position = UDim2New(Star.X + 0.012 * MathSin(Now * 0.12 + Star.Phase), 0, Y, 0)
                        Star.Frame.BackgroundTransparency = 1 - Fade * (0.12 + 0.16 * (0.5 + 0.5 * MathSin(Now * 0.35 + Star.Phase)))
                    end
                end)
            end
