        local LastLogUpdate = os.clock()
        local function UpdateHitLogs(Now)
            local Settings = E.HitLogs
            local Delta = math.clamp(Now - LastLogUpdate, 0, 0.1)
            LastLogUpdate = Now
            if not Settings.Enabled then
                if #Logs > 0 or next(PendingLogShots) or next(PendingLogReports) then E:ClearHitLogs() end
            elseif Now >= NextPendingCleanup then
                NextPendingCleanup = Now + 0.25
                for Id, Pending in pairs(PendingLogShots) do
                    if Now - Pending.Created > 3 then PendingLogShots[Id] = nil end
                end
                for Id, Report in pairs(PendingLogReports) do
                    if Now - Report.Created > 3 then PendingLogReports[Id] = nil end
                end
            end
            for Index = #Logs, 1, -1 do if Now >= Logs[Index].Expires then RemoveLog(Index) end end
            local DisplayLogs = #Logs > 0 and Logs or Settings.Preview and PreviewLogs or Logs
            local Count = math.min(#DisplayLogs, math.clamp(Settings.MaxEntries, 1, 12))
            local Visible = E.Active and (Settings.Enabled or Settings.Preview) and Count > 0
            if LogPanel.Visible ~= Visible then LogPanel.Visible = Visible end
            if not Visible then return end
            local Position, Size = UDim2.fromOffset(Settings.X, Settings.Y), UDim2.fromOffset(Settings.Width, Count * 24)
            if LogPanel.Position ~= Position then LogPanel.Position = Position end
            if LogPanel.Size ~= Size then LogPanel.Size = Size end
            for Index = 1, Count do
                local Label = LogRows[Index]
                if not Label then
                    Label = Make("TextLabel", {Parent = LogPanel, FontFace = Font, TextSize = 12,
                        BackgroundTransparency = 1, BorderSizePixel = 0, RichText = true,
                        TextStrokeColor3 = Color3.new(), TextStrokeTransparency = 0.4,
                        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                        Size = UDim2.new(1, -20, 0, 22), ZIndex = 5})
                    LogRows[Index], LogRowStates[Index] = Label, {}
                end
                local Row, Entry = LogRowStates[Index], DisplayLogs[#DisplayLogs - Index + 1]
                local Status = Entry.Accepted and (Entry.Damage > 0 and "Accepted" or "Accepted (unconfirmed)")
                    or Entry.Server == "rejected" and "Rejected" or "Pending"
                local StatusColor = Entry.Accepted and Library.Theme.Accent or Entry.Server == "rejected" and Red or Gray
                if Row.Id ~= Entry.Id or Row.Damage ~= Entry.Damage or Row.Status ~= Status or Row.Color ~= StatusColor
                    or Row.Target ~= Entry.Target or Row.Bone ~= Entry.Bone or Row.Hit ~= Entry.Hit then
                    local DamageText = Entry.Damage > 0 and (string.format("%.1f", Entry.Damage):gsub("%.0$", "") .. " dmg | ") or ""
                    local Details = Entry.Target and (" | " .. Entry.Target .. (Entry.Bone and (" (" .. Entry.Bone .. ")") or "")) or ""
                    Details = Details:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
                    local KillText = Entry.Hit == "death observed" and " | Kill" or ""
                    Label.Text = DamageText .. '<font color="#' .. StatusColor:ToHex() .. '">' .. Status .. '</font>' .. KillText .. Details
                    Row.Id, Row.Damage, Row.Status, Row.Color = Entry.Id, Entry.Damage, Status, StatusColor
                    Row.Target, Row.Bone, Row.Hit = Entry.Target, Entry.Bone, Entry.Hit
                end
                local Enter = math.clamp((Now - Entry.Created) / 0.25, 0, 1)
                local Ease = 1 - (1 - Enter) ^ 3
                local Exit = math.clamp((Entry.Expires - Now) / 0.4, 0, 1)
                local Alpha = Ease * Exit
                local TargetY = (Index - 1) * 24
                Row.Y = Row.Y and (Row.Y + (TargetY - Row.Y) * (1 - math.exp(-Delta * 18))) or TargetY
                local RowPosition = UDim2.fromOffset((1 - Ease) * 12, Row.Y + (1 - Ease) * 5 - (1 - Exit) * 6)
                if Label.Position ~= RowPosition then Label.Position = RowPosition end
                local Transparency = 1 - Alpha
                if Label.TextTransparency ~= Transparency then Label.TextTransparency = Transparency end
                local Stroke = 1 - Alpha * 0.6
                if Label.TextStrokeTransparency ~= Stroke then Label.TextStrokeTransparency = Stroke end
                local Pulse = Entry.PulseAt and math.max(0, 1 - (Now - Entry.PulseAt) / 0.35) or 0
                local Color = Library.Theme.Text:Lerp(Library.Theme.Accent, Pulse * 0.65)
                if Label.TextColor3 ~= Color then Label.TextColor3 = Color end
                if not Label.Visible then Label.Visible = true end
            end
            for Index = Count + 1, #LogRows do
                if LogRows[Index].Visible then LogRows[Index].Visible = false end
            end
        end
