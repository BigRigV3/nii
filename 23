            Library.InventoryViewer = function(self, Title, Position)
                local Library = self
                local Connections = {}
                local Instances = {}
                function Instances:Create(Class, Properties)
                    Library:YieldLoadingWork()
                    local Object = Instance.new(Class)
                    for Property, Value in pairs(Properties) do Object[Property] = Value end
                    local Wrapper = {Instance = Object}
                    function Wrapper:AddToTheme(Properties)
                        Library:AddToTheme(self, Properties)
                    end
                    function Wrapper:MakeDraggable()
                        Object.Active = true
                        local InputService = game:GetService("UserInputService")
                        local Dragging, Start, Origin
                        table.insert(Connections, Object.InputBegan:Connect(function(Input)
                            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                                Dragging, Start, Origin = true, Input.Position, Object.Position
                            end
                        end))
                        table.insert(Connections, InputService.InputEnded:Connect(function(Input)
                            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                                Dragging = false
                            end
                        end))
                        table.insert(Connections, InputService.InputChanged:Connect(function(Input)
                            if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
                                local Delta = Input.Position - Start
                                Object.Position = UDim2.new(Origin.X.Scale, Origin.X.Offset + Delta.X, Origin.Y.Scale, Origin.Y.Offset + Delta.Y)
                            end
                        end))
                    end
                    return Wrapper
                end
                local Rows = {}
                local Viewer = {Mode = "Text", Columns = 5, IconSize = 48, Entries = {}, Rows = Rows, EmptyText = "Empty", TextWidths = {}}
                local Root = Instances:Create("Frame", {
                    Parent = Library.Holder.Instance, Name = "InventoryViewer",
                    Position = Position or UDim2.new(0, 12, 0, 100),
                    Size = UDim2.fromOffset(180, 54), Visible = false,
                    BackgroundColor3 = Library.Theme.Background,
                    BorderColor3 = Library.Theme.Border, BorderSizePixel = 2,
                })
                Root:AddToTheme({BackgroundColor3 = "Background", BorderColor3 = "Border"})
                Root:MakeDraggable()
                Instances:Create("UIStroke", {
                    Parent = Root.Instance, Color = Library.Theme.Outline,
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                }):AddToTheme({Color = "Outline"})
                Instances:Create("Frame", {
                    Parent = Root.Instance, Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Library.Theme.Accent, BorderSizePixel = 0,
                }):AddToTheme({BackgroundColor3 = "Accent"})
                local TitleLabel = Instances:Create("TextLabel", {
                    Parent = Root.Instance, Position = UDim2.fromOffset(8, 4),
                    Size = UDim2.new(1, -16, 0, 20), BackgroundTransparency = 1,
                    Text = Title or "Inventory", FontFace = Library.Font, TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Library.Theme.Text,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
                TitleLabel:AddToTheme({TextColor3 = "Text"})
                local StatsLabel = Instances:Create("TextLabel", {
                    Parent = Root.Instance, Name = "PlayerStatistics", Position = UDim2.fromOffset(8, 26),
                    Size = UDim2.new(1, -16, 0, 18), BackgroundTransparency = 1,
                    Text = "", FontFace = Library.Font, TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Library.Theme.Text,
                    TextTruncate = Enum.TextTruncate.AtEnd, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.5, Visible = false,
                })
                StatsLabel:AddToTheme({TextColor3 = "Text"})
                local Content = Instance.new("ScrollingFrame")
                Content.Name = "Items"
                Content.Parent = Root.Instance
                Content.Position = UDim2.fromOffset(8, 28)
                Content.BackgroundTransparency = 1
                Content.BorderSizePixel = 0
                Content.ScrollBarThickness = 3
                Content.ScrollingDirection = Enum.ScrollingDirection.Y
                Content.CanvasSize = UDim2.fromOffset(0, 0)
                Viewer.Instance = Root.Instance

                local function Label(Parent, Text, Size, Position)
                    local Result = Instance.new("TextLabel")
                    Result.Parent = Parent
                    Result.BackgroundTransparency = 1
                    Result.BorderSizePixel = 0
                    Result.FontFace = Library.Font
                    Result.TextSize = 11
                    Result.TextColor3 = Library.Theme.Text
                    Result.TextStrokeTransparency = 0
                    Result.TextStrokeColor3 = Color3.new(0, 0, 0)
                    Result.TextXAlignment = Enum.TextXAlignment.Left
                    Result.Text = Text
                    Result.Size = Size
                    Result.Position = Position
                    return Result
                end

                function Viewer.Render()
                    if Viewer.Destroyed then return end
                    if Viewer.MeasuredFont ~= Library.Font then
                        Viewer.TextWidths = {}
                        Viewer.MeasuredFont = Library.Font
                    end
                    Viewer.RenderRevision = (Viewer.RenderRevision or 0) + 1
                    local Revision = Viewer.RenderRevision
                    local Entries = Viewer.Entries
                    for _, Row in ipairs(Rows) do Row:Destroy() end
                    table.clear(Rows)
                    local Camera = workspace.CurrentCamera
                    local Viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
                    local Count = #Entries
                    local Width, Height = 164, 18
                    if Viewer.Mode == "Image" and Count > 0 then
                        local Columns = math.min(Viewer.Columns, Count,
                            math.max(1, math.floor((Viewport.X - 56) / (Viewer.IconSize + 8))))
                        local CellWidth, CellHeight = Viewer.IconSize, Viewer.IconSize
                    for _, Entry in ipairs(Entries) do if Entry.Caption then CellHeight = Viewer.IconSize + 42; break end end
                        Width = Columns * (CellWidth + 8) - 8
                        Height = math.ceil(Count / Columns) * (CellHeight + 8) - 8
                        for Index, Entry in ipairs(Entries) do
                            local X = ((Index - 1) % Columns) * (CellWidth + 8)
                            local Y = math.floor((Index - 1) / Columns) * (CellHeight + 8)
                            local Icon = Instance.new("ImageLabel")
                            Icon.Name = Entry.Name
                            Icon.Parent = Content
                            Icon.Position = UDim2.fromOffset(X, Y)
                            Icon.Size = UDim2.fromOffset(Viewer.IconSize, Viewer.IconSize)
                            Icon.BackgroundTransparency = 1
                            Icon.Image = Entry.Image or ""
                            Icon.ScaleType = Enum.ScaleType.Fit
                            local Amount = tonumber(Entry.Amount) or 1
                            if Amount > 1 then
                                local Stack = Label(Icon, "x" .. tostring(Amount),
                                    UDim2.new(1, -6, 0, 18), UDim2.new(0, 3, 1, -3))
                                Stack.Name = "StackAmount"
                                Stack:SetAttribute("CinnamonPreserveFont", true)
                                Stack.FontFace = Font.fromEnum(Enum.Font.FredokaOne)
                                Stack.AnchorPoint = Vector2.new(0, 1)
                                Stack.TextSize = math.clamp(math.floor(Viewer.IconSize * 0.28), 12, 18)
                                Stack.TextColor3 = Color3.new(1, 1, 1)
                                Stack.TextYAlignment = Enum.TextYAlignment.Bottom
                                Stack.ZIndex = Icon.ZIndex + 1
                            end
                        if Entry.Caption then
                            local Caption = Label(Content, Entry.Caption, UDim2.fromOffset(CellWidth, 40), UDim2.fromOffset(X, Y + Viewer.IconSize + 2))
                            Caption.TextWrapped, Caption.TextSize, Caption.TextXAlignment = true, 9, Enum.TextXAlignment.Center
                            Caption.TextColor3 = Entry.NameColor or Library.Theme.Text
                            table.insert(Rows, Caption)
                        end
                            table.insert(Rows, Icon)
                        end
                    else
                        local TextService = game:GetService("TextService")
                        Height = math.max(Count, 1) * 22
                        for _, Entry in ipairs(Entries) do
                            local Text = Entry.Name .. (Entry.AmountLabel and " " .. Entry.AmountLabel or " x" .. tostring(Entry.Amount))
                            if not Viewer.TextWidths[Text] then
                                local Parameters = Instance.new("GetTextBoundsParams")
                                Parameters.Text, Parameters.Font, Parameters.Size, Parameters.Width = Text, Library.Font, 11, 10000
                                local Success, Bounds = pcall(function() return TextService:GetTextBoundsAsync(Parameters) end)
                                Parameters:Destroy()
                                Viewer.TextWidths[Text] = Success and Bounds.X or #Text * 7
                                if Viewer.Destroyed or Viewer.RenderRevision ~= Revision then return end
                            end
                            Width = math.max(Width, Viewer.TextWidths[Text] + 12)
                        end
                        for Index, Entry in ipairs(Entries) do
                            local Name = Entry.Name:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
                            if Entry.NameColor then
                                Name = '<font color="#' .. Entry.NameColor:ToHex() .. '">' .. Name .. '</font>'
                            end
                            local Row = Label(Content, Name .. (Entry.AmountLabel and " " .. Entry.AmountLabel or " x" .. tostring(Entry.Amount)),
                                UDim2.fromOffset(Width, 22), UDim2.fromOffset(0, (Index - 1) * 22))
                            Row.RichText = true
                            table.insert(Rows, Row)
                        end
                    end
                    if Count == 0 then
                        table.insert(Rows, Label(Content, Viewer.EmptyText, UDim2.fromOffset(Width, 18), UDim2.fromOffset(0, 0)))
                    end
                    Viewer.ContentWidth, Viewer.ContentHeight = Width, Height
                    Viewer:UpdateLayout()
                end

                function Viewer:UpdateLayout()
                    if self.Destroyed or not self.ContentWidth then return end
                    local Width, Height = self.ContentWidth, self.ContentHeight
                    local Camera = workspace.CurrentCamera
                    local Viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
                    local HeaderLines = Viewer.Stats and Viewer.Stats ~= "" and select(2, Viewer.Stats:gsub("\n", "")) + 1 or 0
                    local HeaderHeight = HeaderLines * 20 + (HeaderLines > 0 and 6 or 0)
                    if HeaderHeight > 0 then
                        StatsLabel.Instance.Size = UDim2.new(1, -16, 0, HeaderHeight)
                        for Line in Viewer.Stats:gmatch("[^\n]+") do Width = math.max(Width, #Line * 7 + 12) end
                    end
                    Content.Position = UDim2.fromOffset(8, 32 + HeaderHeight)
                    Width = math.min(Width, math.max(164, Viewport.X - 40))
                    local VisibleHeight = math.min(Height, math.max(18, Viewport.Y * 0.6))
                    Content.Size = UDim2.fromOffset(Width, VisibleHeight)
                    Content.CanvasSize = UDim2.fromOffset(Width, Height)
                    Root.Instance.Size = UDim2.fromOffset(Width + 16, VisibleHeight + 40 + HeaderHeight)
                end

                function Viewer:SetItems(Entries)
                    local Camera = workspace.CurrentCamera
                    local Parts = {tostring(Library.Theme.Text), tostring(Camera and Camera.ViewportSize)}
                    for _, Entry in ipairs(Entries) do
                        table.insert(Parts, Entry.Name .. "\0" .. tostring(Entry.Amount) .. "\0" .. (Entry.Image or "") .. "\0" .. tostring(Entry.NameColor) .. "\0" .. (Entry.Caption or "") .. "\0" .. (Entry.AmountLabel or ""))
                    end
                    local Signature = table.concat(Parts, "\1")
                    if self.Signature == Signature then return end
                    self.Signature, self.Entries = Signature, Entries
                    self:Render()
                end

                function Viewer:SetMode(Mode)
                    self.Mode = Mode == "Image" and "Image" or "Text"
                    self:Render()
                end
                function Viewer:SetStats(Text)
                    Text = Text or ""
                    if self.Stats == Text then return end
                    self.Stats = Text
                    StatsLabel.Instance.Text = Text
                    StatsLabel.Instance.Visible = Text ~= ""
                    self:UpdateLayout()
                end
                function Viewer:SetTitle(Text)
                    TitleLabel.Instance.Text = Text
                end
                function Viewer:SetEmptyText(Text)
                    if self.EmptyText == Text then return end
                    self.EmptyText = Text
                    if #self.Entries == 0 then self:Render() end
                end
                function Viewer:SetColumns(Columns)
                    self.Columns = math.clamp(math.floor(Columns), 1, 12)
                    self:Render()
                end
                function Viewer:SetIconSize(Size)
                    self.IconSize = math.clamp(math.floor(Size), 24, 96)
                    self:Render()
                end
                function Viewer:SetVisibility(Visible)
                    Root.Instance.Visible = Visible
                end
                function Viewer:Destroy()
                    self.Destroyed = true
                    if Library.MenuFontViewers then Library.MenuFontViewers[self] = nil end
                    for _, Connection in ipairs(Connections) do Connection:Disconnect() end
                    for Index = #Library.ThemeItems, 1, -1 do
                        local Item = Library.ThemeItems[Index].Item
                        if Item == Root.Instance or Item:IsDescendantOf(Root.Instance) then
                            Library.ThemeMap[Item] = nil
                            table.remove(Library.ThemeItems, Index)
                        end
                    end
                    Root.Instance:Destroy()
                end
                Library.MenuFontViewers = Library.MenuFontViewers or setmetatable({}, {__mode = "k"})
                Library.MenuFontViewers[Viewer] = true
                Viewer:Render()
                return Viewer
            end

