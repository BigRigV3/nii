        local OriginalUIColors, GameUIObjects, GameUIObjectSet = {}, {}, {}
        local function ApplyGameUIColor(Object)
            if not GameUIColorSettings.Enabled or not Object or not Object:IsA("GuiObject") then return end
            if Object.BackgroundTransparency >= 1 then return end
            local Entry = OriginalUIColors[Object]
            if not Entry then
                Entry = {Original = Object.BackgroundColor3}
                OriginalUIColors[Object] = Entry
                if not GameUIObjectSet[Object] then
                    GameUIObjectSet[Object] = true
                    GameUIObjects[#GameUIObjects + 1] = Object
                end
            end
            Entry.Applied = Entry.Original:Lerp(GameUIColorSettings.Color, GameUIColorSettings.Strength)
            if Object.BackgroundColor3 ~= Entry.Applied then
                pcall(function() Object.BackgroundColor3 = Entry.Applied end)
            end
        end
        local function RestoreGameUIColors()
            for Object, Entry in pairs(OriginalUIColors) do
                pcall(function()
                    if Object.Parent and Object.BackgroundColor3 == Entry.Applied then
                        Object.BackgroundColor3 = Entry.Original
                    end
                end)
            end
            table.clear(OriginalUIColors)
            table.clear(GameUIObjects)
            table.clear(GameUIObjectSet)
        end
        local function QueueGameUIColorRefresh()
            if not GameUIColorSettings.Enabled or not PlayerGui then return end
            if not next(OriginalUIColors) then
                local Descendants = PlayerGui:GetDescendants()
                for _, Object in ipairs(Descendants) do
                    if Object:IsA("GuiObject") and Object.BackgroundTransparency < 1 then
                        local Entry = {Original = Object.BackgroundColor3}
                        OriginalUIColors[Object] = Entry
                        GameUIObjectSet[Object] = true
                        GameUIObjects[#GameUIObjects + 1] = Object
                    end
                end
            end
            for _, Object in ipairs(GameUIObjects) do ApplyGameUIColor(Object) end
        end
