            return function(Signal, Callback, Interval)
                if Signal ~= Run.Heartbeat and Signal ~= Run.RenderStepped
                    and Signal ~= Run.PreSimulation and Signal ~= Run.PostSimulation then
                    return Signal:Connect(Callback)
                end
                local Group = Groups[Signal]
                if not Group then
                    Group = {Entries = {}, Count = 0}
                    Groups[Signal] = Group
                end
                local Entry = {Connected = true, Callback = Callback, Interval = Interval or 0, Elapsed = 0}
                Entry.Worker = coroutine.create(function(Delta)
                    while Entry.Connected do
                        Entry.Busy = true
                        local Ok, Error = pcall(Entry.Callback, Delta)
                        Entry.Busy = false
                        if not Ok and Entry.Connected then
                            local Now = os.clock()
                            if not Entry.LastError or Now - Entry.LastError >= 5 then
                                Entry.LastError = Now
                                warn("[Cinnamon] Frame callback failed: " .. tostring(Error))
                            end
                        end
                        if not Entry.Connected then return end
                        Delta = coroutine.yield()
                    end
                end)
                function Entry:Disconnect()
                    if not self.Connected then return end
                    self.Connected, self.Callback = false, nil
                    Group.Count -= 1
                    Group.Dirty = true
                    if not self.Busy then pcall(coroutine.close, self.Worker) end
                    if Group.Count == 0 then
                        Group.Connection:Disconnect()
                        Groups[Signal] = nil
                        table.clear(Group.Entries)
                    end
