            function Functions:GetCharacterScreenBounds(Character)
                local minX, minY = math.huge, math.huge
                local maxX, maxY = -math.huge, -math.huge
                local Cache = BodyParts[Character]
                local Now = FrameState.Now
                if not Cache or Now >= Cache.NextRefresh then
                    Cache = {Parts = {}, NextRefresh = Now + 0.5}
                    for _, Part in ipairs(Character:GetChildren()) do
                        if Part:IsA("BasePart") and Part.Name ~= "HumanoidRootPart" then
                            table.insert(Cache.Parts, Part)
                        end
                    end
                    BodyParts[Character] = Cache
                end
                
                
                
                local CenterX, CenterY = FrameState.CenterX, FrameState.CenterY
                local Scale, CameraFrame = FrameState.Scale, FrameState.Frame
                local Root = ESP:GetNPCRoot(Character, Character:FindFirstChildOfClass("Humanoid"))
                if not Root then return nil end
                if not Cache.BoundsSize or Now >= (Cache.NextBounds or 0) then
                    local Low, High = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
                    for _, Part in ipairs(Cache.Parts) do
                        if Part.Parent ~= Character then continue end
                        local Relative = Root.CFrame:ToObjectSpace(Part.CFrame)
                        local px, py, pz, a, b, c, d, e, f, g, h, i = Relative:GetComponents()
                        local Half = Part.Size * 0.5
                        local Extent = Vector3.new(math.abs(a)*Half.X + math.abs(b)*Half.Y + math.abs(c)*Half.Z,
                            math.abs(d)*Half.X + math.abs(e)*Half.Y + math.abs(f)*Half.Z,
                            math.abs(g)*Half.X + math.abs(h)*Half.Y + math.abs(i)*Half.Z)
                        local Min, Max = Vector3.new(px, py, pz) - Extent, Vector3.new(px, py, pz) + Extent
                        Low = Vector3.new(math.min(Low.X, Min.X), math.min(Low.Y, Min.Y), math.min(Low.Z, Min.Z))
                        High = Vector3.new(math.max(High.X, Max.X), math.max(High.Y, Max.Y), math.max(High.Z, Max.Z))
                    end
                    if Low.X == math.huge then return nil end
                    Cache.BoundsCenter, Cache.BoundsSize = (Low + High) * 0.5, High - Low
                    Cache.NextBounds = Now + 0.1
                end
                -- Refresh animated extents at 10 Hz; project the moving rig every render frame.
                Cache.BoundsProxy = Cache.BoundsProxy or {}
                local Proxy = Cache.BoundsProxy
                Proxy.Parent, Proxy.Size, Proxy.CFrame = Character, Cache.BoundsSize, Root.CFrame * CFrame.new(Cache.BoundsCenter)
                Cache.ProjectionParts = Cache.ProjectionParts or {Proxy}
                for _, part in ipairs(Cache.ProjectionParts) do
                    if part.Parent == Character then
                        local Size = part.Size
                        local HalfX, HalfY, HalfZ = Size.X * 0.5, Size.Y * 0.5, Size.Z * 0.5
                        local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = CameraFrame:ToObjectSpace(part.CFrame):GetComponents()
                        for x = -1, 1, 2 do
                            for y = -1, 1, 2 do
                                for z = -1, 1, 2 do
                                    local X, Y, Z = HalfX * x, HalfY * y, HalfZ * z
                                    local Depth = -(pz + r20 * X + r21 * Y + r22 * Z)
                                    if Depth <= 0 then return nil end
                                    local ScreenX = CenterX + (px + r00 * X + r01 * Y + r02 * Z) * Scale / Depth
                                    local ScreenY = CenterY - (py + r10 * X + r11 * Y + r12 * Z) * Scale / Depth
                                    if ScreenX < minX then minX = ScreenX end
                                    if ScreenY < minY then minY = ScreenY end
                                    if ScreenX > maxX then maxX = ScreenX end
                                    if ScreenY > maxY then maxY = ScreenY end
                                end
                            end
                        end
                    end
                end

                if minX == math.huge then
                    return nil
                end

                return Vector2.new((minX + maxX) / 2, (minY + maxY) / 2), maxX - minX, maxY - minY
            end
            
