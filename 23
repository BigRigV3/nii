        local RenderConnection = ConnectScheduled(Run.RenderStepped, function()
            if not S.Enabled or (not S.Line and not S.TargetText) or not next(Routes) then HideGuide(); return end
            local Root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not Root then HideGuide(); return end
            if Source.Parent ~= Root then Source.Parent = Root end
            local Camera = workspace.CurrentCamera
            for _, R in pairs(Routes) do
                local T, Part = R.Target, R.Target.Part
