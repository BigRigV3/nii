            function Editor:Register(Kind, Object, Gui, Content, Parent, Window, Name)
                local Order = (self.Orders[Gui.Parent] or 0) + 1
                self.Orders[Gui.Parent] = Order
                Gui.LayoutOrder = Order
                local Record = {Kind = Kind, Object = Object, Gui = Gui, Content = Content,
                    Parent = Parent, Window = Window, Name = Name, OriginalParent = Gui.Parent,
                    OriginalOrder = Order, OriginalSize = Content.Size, OriginalPosition = Content.Position,
                    OriginalAutomaticSize = Content.AutomaticSize, OriginalPage = Object.Page, OriginalSide = Object.Side}
                table.insert(self.Items, Record)
                return Record
            end
            local function Insertion(Record, Parent, Position, Horizontal)
                local Items = {}
                for _, Other in ipairs(Editor.Items) do
                    if Other ~= Record and Other.Gui.Parent == Parent and not Other.Floating then table.insert(Items, Other) end
                end
                table.sort(Items, function(A, B) return A.Gui.LayoutOrder < B.Gui.LayoutOrder end)
                local Index = #Items + 1
                for I, Other in ipairs(Items) do
                    local Center = Other.Gui.AbsolutePosition + Other.Gui.AbsoluteSize / 2
                    if (Horizontal and Position.X < Center.X) or (not Horizontal and Position.Y < Center.Y) then Index = I; break end
                end
                return Items, Index
            end
            local function Reorder(Record, Parent, Position, Horizontal)
                local Items, Index = Insertion(Record, Parent, Position, Horizontal)
                table.insert(Items, Index, Record)
                Record.Gui.Parent = Parent
                for I, Other in ipairs(Items) do Other.Gui.LayoutOrder = I end
            end
            function Editor:PreviewPlacement(Record, Position)
                if not self.PreviewEnabled then return end
                if Record.Kind == "Section" then
                    for _, Wrapper in pairs(Record.Object.Page.ColumnsData) do
                        local Column = Wrapper.Instance
                        if Contains(Column, Position) then
                            local Items, Index = Insertion(Record, Column, Position, false)
                            local Layout = Column:FindFirstChildOfClass("UIListLayout")
                            local Padding = Column:FindFirstChildOfClass("UIPadding")
                            local Gap = Layout and Layout.Padding.Offset or 14
                            local Y = Column.AbsolutePosition.Y - Column.CanvasPosition.Y + (Padding and Padding.PaddingTop.Offset or 0)
                            for I = 1, Index - 1 do Y = Y + Items[I].Gui.AbsoluteSize.Y + Gap end
                            local MinY, MaxY = Column.AbsolutePosition.Y, Column.AbsolutePosition.Y + Column.AbsoluteSize.Y
                            local EndY = math.min(MaxY - 2, Y + Record.Gui.AbsoluteSize.Y)
                            Y = math.max(MinY + 2, Y)
                            if EndY > Y then
                                self:ShowPreview(Vector2.new(Column.AbsolutePosition.X + 2, Y), Vector2.new(Column.AbsoluteSize.X - 4, EndY - Y))
                            else self:HidePreview() end
                            return
                        end
                    end
                elseif Contains(Record.Gui.Parent, Position) then
                    local Parent, Horizontal = Record.Gui.Parent, Record.Kind == "SubPage"
                    local Items, Index = Insertion(Record, Parent, Position, Horizontal)
                    local Other = Items[Index] or Items[#Items]
                    local Origin = Other and Other.Gui.AbsolutePosition or Parent.AbsolutePosition
                    if Other and Index > #Items then
                        Origin = Origin + (Horizontal and Vector2.new(Other.Gui.AbsoluteSize.X, 0) or Vector2.new(0, Other.Gui.AbsoluteSize.Y))
                    end
                    self:ShowPreview(Origin, Horizontal and Vector2.new(3, Record.Gui.AbsoluteSize.Y) or Vector2.new(Parent.AbsoluteSize.X, 3))
                    return
                end
                if not Contains(Record.Window.Items.Window.Instance, Position) then
                    self:PreviewWindow(Record.Window.Items.Window.Instance, Position)
                else self:HidePreview() end
            end
            function Editor:Dock(Record)
                if not Record.Floating then return end
                local Host = Record.Floating
                Record.Floating = nil
                Record.Object.LayoutFloating = nil
                local Content = Record.Content
                Content.Size, Content.Position = Record.OriginalSize, Record.OriginalPosition
                Content.AutomaticSize = Record.OriginalAutomaticSize
                if Record.Kind == "Section" then
                    Content.Parent = Record.DockParent or Record.OriginalParent
                    Content.Visible = true
                else
                    Content.Parent = Record.Parent
                    Record.Object:Turn(Record.Object.Active)
                end
                Host:Destroy()
            end
            function Editor:Detach(Record, Position)
