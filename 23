            local function YieldWork()
                if os.clock() - WorkStart >= 0.001 then task.wait(); WorkStart = os.clock() end
                return Alive and Settings.Enabled and Wanted[Model] and Models[Model] == State
            end
            if not State then
                State = {Objects = {}, Detaching = false}
                Models[Model] = State
                local function Add(Object)
                    if State.Objects[Object] then return end
                                                                                                
                    if Object:FindFirstAncestorOfClass("Tool") then return end
                    local Original
                    if Object:IsA("BasePart") then
                        if Object.Name == "HumanoidRootPart" or Object.Transparency >= 1 then return end
                        Original = {Material = Object.Material, MaterialVariant = Object.MaterialVariant,
                            Color = Object.Color, Transparency = Object.Transparency, Reflectance = Object.Reflectance}
                        if Object:IsA("MeshPart") then Original.TextureID = Object.TextureID end
                    elseif Object:IsA("SpecialMesh") then Original = {TextureId = Object.TextureId}
                    elseif Object:IsA("SurfaceAppearance") then Original = {Parent = Object.Parent}
                    elseif Object:IsA("Decal") or Object:IsA("Texture") then Original = {Transparency = Object.Transparency}
                    elseif Object:IsA("Shirt") then Original = {ShirtTemplate = Object.ShirtTemplate}
                    elseif Object:IsA("Pants") then Original = {PantsTemplate = Object.PantsTemplate}
                    elseif Object:IsA("ShirtGraphic") then Original = {Graphic = Object.Graphic}
                    end
                    if not Original then return end
                    State.Objects[Object] = Original
                    State.Detaching = true
                    UpdateObject(Object, Original)
                    State.Detaching = false
                end
                State.Added = Model.DescendantAdded:Connect(Add)
                State.Removing = Model.DescendantRemoving:Connect(function(Object)
                    if State.Detaching then return end
                    local Original = State.Objects[Object]
                    if Original and Object:IsA("SurfaceAppearance") and not Object.Parent and Settings.RemoveTextures then return end
                    if Original then State.Objects[Object] = nil; RestoreObject(Object, Original) end
                end)
