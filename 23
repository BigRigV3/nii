        local function Perform(Action, OnlySelected)
            if OnlySelected and S.Selected == "All active quests" then Result:SetText("Select one active quest first"); return end
            if S.Busy then Result:SetText("Quest action already running"); return end
            if not API or not QuestRoot() then Result:SetText("Quests are unavailable in this game mode"); return end
            S.Busy = true
            task.spawn(function()
                local Done, Failed, Tried, FirstFailure = 0, 0, {}, nil
                local function Call(Key, Fn)
                    if not Alive or Tried[Key] then return end
                    Tried[Key] = true
                    Result:SetText("Processing " .. tostring(Key) .. "...")
                    local Success, Value, Reason = CallQuestAPI(Fn)
                    if Success and Value ~= nil and Value ~= false then
                        Done += 1
                    else
                        Failed += 1
                        FirstFailure = FirstFailure or tostring(Reason or (not Success and Value) or "Game rejected the quest action")
                    end
                    task.wait(0.2)
                end
                local Success, Error = pcall(function()
                    if Action == "ActivateOne" then
                        RefreshAvailable(true)
                        local ID = AvailableChoice == "Next available quest" and AvailableIDs[1] or AvailableLabels[AvailableChoice]
                        if ID then Call(ID, function() return API.new(ID) end) end
                    elseif Action == "Activate" then
                        local Givers = {}
                        for _, Def in pairs(API.Quests or {}) do if Def.QuestGivenBy then Givers[Def.QuestGivenBy] = true end end
                        for Giver in pairs(Givers) do
                            for _ = 1, 8 do
                                if not Alive then break end
                                local Success, ID = CallQuestAPI(API.GetAvailableQuest, API, Player, Giver)
                                if not Success then error(ID) end
                                if not ID or Tried[ID] then break end
                                Call(ID, function() return API.new(ID) end)
                            end
                        end
                    elseif Action == "HandOver" then
                        local Entries = Snapshot(not OnlySelected)
                        for _, Entry in ipairs(Entries) do
                            if Entry.Type == "HandOver" and not Entry.Complete and (Entry.Have or 0) > 0 then
                                local Def = API.Quests[Entry.Id]
                                local Giver = Def and Def.QuestGivenBy
                                if Giver then Call(Giver, function() return API:handOver(Giver) end) end
                            end
                        end
                    else
                        for _, Quest in ipairs(ActiveFolders()) do
                            if Quest:GetAttribute("State") == "Active" and (not OnlySelected or Quest.Name == S.Selected) then
                                local Ready, Required = true, 0
                                for _, O in ipairs(Quest:GetChildren()) do
                                    local Def = API.Quests[Quest.Name]
                                    local Objective = Def and Def.Objectives and (Def.Objectives[O.Name] or Def.Objectives[tonumber(O.Name)])
                                    if not (O:GetAttribute("Optional") or Objective and Objective.Optional) then
                                        Required += 1
                                        if not (O:GetAttribute("Complete") or O:GetAttribute("Carrying") or O:GetAttribute("Placed")) then Ready = false end
                                        -- The quest server accepts carried fetch items on field maps,
                                        -- including objectives marked Survive. Let it validate the hand-in.
                                    end
                                end
                                if Ready and Required > 0 then Call(Quest.Name, function() return API:complete(Quest.Name) end) end
                            end
                        end
                    end
                end)
                S.Busy = false
                if Alive then
                    local Text = Success and (Done + Failed == 0 and "No matching quests or items are ready" or string.format("Accepted %d | Rejected %d", Done, Failed)) or "Quest action failed: " .. tostring(Error)
                    if Success and FirstFailure then Text ..= " | " .. FirstFailure end
                    Result:SetText(Text)
                    S.LastAction = {Accepted = Done, Rejected = Failed, Error = FirstFailure or (not Success and tostring(Error) or nil)}
                    Refresh()
                end
            end)
        end
        Actions:Button():Add("Accept all available quests", function() Perform("Activate") end)
