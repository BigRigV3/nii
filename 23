            local function QueueHit(Shot)
                if Shot.Queued or not Shot.Accepted or not Shot.Part or not Shot.Origin or not Shot.Ammo then return end
                local Speed = tonumber(ReadAttribute(Shot.Ammo, "MuzzleVelocity"))
                if not Speed or Speed <= 0 then return end
                Shot.Queued = true
                                                                                        
                local Travel = Controller.Mods.InstantBullet and 0.11 or math.max(0.11, (Shot.Part.Position - Shot.Origin).Magnitude / Speed)
                task.delay(math.max(0, Travel - (os.clock() - Shot.Created)), function()
                    if not Controller.Active or not (Controller:IsAimActive() or Controller:IsRageActive()
                        or Controller:IsManipulationActive() or Controller:IsHitscanActive() or Controller:IsMagicBulletActive())
                        or Shots[Shot.Id] ~= Shot or Shot.NaturalReported or Shot.Reported
                        or not Shot.Part.Parent then return end
