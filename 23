                end
                table.sort(Ordered, function(A, B) return A.LayoutOrder < B.LayoutOrder end)
                local Bottom, Scroll = 0, nil
                for _, Section in ipairs(Ordered) do
                    local Layout = SectionLayouts[Section]
                    local Width = Layout.Frame.AbsoluteSize.X
                    if Width <= 0 or Layout.HeightScale <= 0 then continue end
                    local Cell = Width * Layout.Cell.X.Scale + Layout.Cell.X.Offset
                    local Height = Cell / Layout.HeightScale
                    Section.Size = UDim2.new(1, 0, 0, Height)
                    Layout.Grid.CellSize = UDim2.new(Layout.Cell.X.Scale, Layout.Cell.X.Offset, 0, Cell)
                    Section.AnchorPoint = Vector2.new(.5, 0)
                    Section.Position = UDim2.new(.5, 0, 0, Bottom)
                    Bottom += Height + math.max(0, Layout.Grid.AbsoluteContentSize.Y - Cell)
                    Scroll = Section.Parent
                end
                if Scroll then Scroll.CanvasSize = UDim2.new(0, 0, 0, Bottom + 16) end
            end
